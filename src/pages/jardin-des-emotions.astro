      /* ==========================================================================
         LOGIQUE APPLICATIVE (VANILLA JS, SANS LIBRAIRIE EXTERNE)
         ========================================================================== */
      (function () {
        const STORAGE_KEY = 'ange_jardin_emotions_read_v1';
        const SVG_W = 1376;
        const SVG_H = 768;

        const state = {
          selectedId: 'joie',
          hoveredId: null,
          readStoryIds: loadReadStories(),
          activeStory: null,
          activeEmotion: null,
          pageIndex: 0,
        };

        const skyStage = document.getElementById('sky-stage');
        const windSvg = document.getElementById('wind-ribbons-svg');
        const emotionDock = document.getElementById('emotion-dock');
        const emotionPanel = document.getElementById('emotion-panel');
        const progressLabel = document.getElementById('progress-label');
        const storyDialog = document.getElementById('story-dialog');
        const readerOrbImg = document.getElementById('reader-orb-img');
        const readerKicker = document.getElementById('reader-kicker');
        const readerTitle = document.getElementById('reader-title');
        const readerPageText = document.getElementById('reader-page-text');
        const readerClosing = document.getElementById('reader-closing');
        const readerPageCounter = document.getElementById('reader-page-counter');
        const readerPrevBtn = document.getElementById('reader-prev-btn');
        const readerNextBtn = document.getElementById('reader-next-btn');
        const readerSpeakBtn = document.getElementById('reader-speak-btn');
        const readerCloseBtn = document.getElementById('reader-close');
        const bedtimeBtn = document.getElementById('btn-bedtime-story');

        document.getElementById('site-title').textContent = ANGE_STORY_DATA.texts.siteTitle;
        document.getElementById('site-subtitle').textContent = ANGE_STORY_DATA.texts.siteSubtitle;
        document.getElementById('ange-caption').textContent = ANGE_STORY_DATA.texts.angeCaption;
        bedtimeBtn.textContent = ANGE_STORY_DATA.texts.bedtimeButton;

        const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        const orbAnimators = [];
        const clusterNodes = new Map();
        const dockNodes = new Map();

        function loadReadStories() {
          try {
            const raw = window.localStorage.getItem(STORAGE_KEY);
            const parsed = raw ? JSON.parse(raw) : [];
            return Array.isArray(parsed) ? parsed : [];
          } catch (_err) {
            return [];
          }
        }

        function saveReadStories() {
          try {
            window.localStorage.setItem(STORAGE_KEY, JSON.stringify(state.readStoryIds));
          } catch (_err) {
            /* ignore storage restrictions */
          }
        }

        function totalStoriesCount() {
          return ANGE_STORY_DATA.emotions.reduce((sum, em) => sum + em.stories.length, 0);
        }

        function updateProgressChip() {
          const total = totalStoriesCount();
          const done = state.readStoryIds.length;
          progressLabel.textContent = `${done} / ${total} histoires écoutées`;
        }

        function getEmotion(id) {
          return ANGE_STORY_DATA.emotions.find((e) => e.id === id) || ANGE_STORY_DATA.emotions[0];
        }

        function createPlanetFxMarkup(emotion) {
          switch (emotion.id) {
            case 'joie':
              return `
                <img src="${emotion.image}" alt="" aria-hidden="true" class="fx-joie-sun" />
                <span class="fx-joie-wing-glow" aria-hidden="true"></span>
              `;
            case 'tristesse':
              return `
                <span class="fx-tristesse-drop" aria-hidden="true"></span>
                <span class="fx-tristesse-ripple" aria-hidden="true"></span>
              `;
            case 'colere':
              return `
                <span class="fx-colere-aura" aria-hidden="true"></span>
                <img src="${emotion.image}" alt="" aria-hidden="true" class="fx-colere-flame" />
              `;
            case 'peur':
              return `
                <img src="${emotion.image}" alt="" aria-hidden="true" class="fx-peur-leaf" />
                <img src="${emotion.image}" alt="" aria-hidden="true" class="fx-peur-tree-front" />
              `;
            case 'timidite':
              return `
                <span class="fx-timidite-blush" aria-hidden="true"></span>
                <img src="${emotion.image}" alt="" aria-hidden="true" class="fx-timidite-petal-left" />
                <img src="${emotion.image}" alt="" aria-hidden="true" class="fx-timidite-petal-right" />
              `;
            case 'inquietude':
              return `
                <img src="${emotion.image}" alt="" aria-hidden="true" class="fx-inquietude-swirl" />
                <span class="fx-inquietude-leaf l1" aria-hidden="true"></span>
                <span class="fx-inquietude-leaf l2" aria-hidden="true"></span>
                <span class="fx-inquietude-leaf l3" aria-hidden="true"></span>
              `;
            case 'calme':
              return `
                <img src="${emotion.image}" alt="" aria-hidden="true" class="fx-calme-sprout" />
              `;
            default:
              return '';
          }
        }

        function elidePlaneteOf(name) {
          return /^[AEIOUYÉÈÊÀÎÔÛ]/i.test(name) ? `Planète d’${name}` : `Planète de ${name}`;
        }

        function buildWindPath(emotion, offsetScale) {
          const sx = ANGE_STORY_DATA.ange.snoutX;
          const sy = ANGE_STORY_DATA.ange.snoutY;
          const tx = (emotion.xPct / 100) * SVG_W;
          const ty = (emotion.yPct / 100) * SVG_H;
          if (emotion.id === 'joie') {
            // Arc gently right around Joie's label instead of cutting behind the text
            const s1 = offsetScale > 0 ? 1 : -0.45;
            return `M ${sx} ${sy} C ${sx + 92 * s1} ${sy - 55}, ${tx + 122 * s1} ${ty + 110}, ${tx} ${ty}`;
          }
          const mx = (sx + tx) / 2;
          const my = (sy + ty) / 2;
          const dx = tx - sx;
          const dy = ty - sy;
          const c1x = sx + dx * 0.25 + dy * 0.16 * offsetScale;
          const c1y = sy + dy * 0.25 - dx * 0.14 * offsetScale;
          const c2x = mx + dx * 0.18 - dy * 0.14 * offsetScale;
          const c2y = my + dy * 0.18 + dx * 0.1 * offsetScale;
          return `M ${sx.toFixed(1)} ${sy.toFixed(1)} C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${tx.toFixed(1)} ${ty.toFixed(1)}`;
        }

        function renderWindRibbons() {
          const selected = getEmotion(state.selectedId);
          const bgPaths = ANGE_STORY_DATA.emotions
            .map((em) => {
              const d = buildWindPath(em, 1);
              return `<path class="wind-ribbon-bg" d="${d}" stroke="#F4C430" stroke-width="2.5" />`;
            })
            .join('');

          const activeMainD = buildWindPath(selected, 1);
          const activeCurlD = buildWindPath(selected, -0.75);
          windSvg.innerHTML = `
            ${bgPaths}
            <path class="wind-ribbon-active-glow" d="${activeMainD}" stroke="${selected.color}" stroke-width="11" />
            <path class="wind-ribbon-active-flow" d="${activeMainD}" stroke="${selected.color}" stroke-width="4" />
            <path class="wind-ribbon-secondary" d="${activeCurlD}" stroke="${selected.softText}" stroke-width="2.2" />
          `;
        }

        function triggerTapBurst(btnEl) {
          btnEl.classList.remove('is-tapped');
          void btnEl.offsetWidth;
          btnEl.classList.add('is-tapped');
          window.clearTimeout(btnEl._tapTimer);
          btnEl._tapTimer = window.setTimeout(() => {
            btnEl.classList.remove('is-tapped');
          }, 800);
        }

        function renderSkyPlanets() {
          ANGE_STORY_DATA.emotions.forEach((emotion, idx) => {
            const cluster = document.createElement('div');
            cluster.className = 'planet-cluster';
            cluster.dataset.emotion = emotion.id;
            cluster.style.setProperty('--px', `${emotion.xPct}%`);
            cluster.style.setProperty('--py', `${emotion.yPct}%`);
            cluster.style.setProperty('--pw', `${emotion.wPct}%`);
            cluster.style.setProperty('--ratio', emotion.ratio);
            cluster.style.setProperty('--emotion-color', emotion.color);
            cluster.style.setProperty('--emotion-glow', emotion.glow);
            cluster.style.setProperty('--rest-dur', emotion.restDur);
            cluster.style.setProperty('--rest-delay', emotion.restDelay);

            const storyCount = emotion.stories.length;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'planet-btn';
            btn.dataset.emotion = emotion.id;
            btn.setAttribute(
              'aria-label',
              `${emotion.name}, ${emotion.characterName}, ${storyCount} histoires`,
            );
            btn.setAttribute('aria-pressed', String(state.selectedId === emotion.id));
            btn.innerHTML = `
              <span class="planet-rest-float">
                <span class="planet-halo" aria-hidden="true"></span>
                <span class="planet-scale-wrap">
                  <img src="${emotion.image}" alt="" class="planet-sprite" />
                  <span class="planet-fx" aria-hidden="true">${createPlanetFxMarkup(emotion)}</span>
                </span>
              </span>
            `;

            const label = document.createElement('span');
            label.className = 'planet-label';
            label.setAttribute('aria-hidden', 'true');
            label.innerHTML = `
              <strong class="planet-label-name">${emotion.name}</strong>
              <em class="planet-label-char">${emotion.characterName}</em>
            `;

            const orbsRing = document.createElement('div');
            orbsRing.className = 'orbs-ring';

            emotion.stories.forEach((story, orbIndex) => {
              const orbBtn = document.createElement('button');
              orbBtn.type = 'button';
              orbBtn.className = 'orb-btn';
              orbBtn.dataset.storyId = story.id;
              orbBtn.setAttribute(
                'aria-label',
                `Histoire : ${story.title} (${emotion.name}, ${story.durationMinutes} minutes)`,
              );
              orbBtn.innerHTML = `<img src="${story.orbImage}" alt="" />`;
              orbBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                selectEmotion(emotion.id);
                openStoryModal(emotion, story);
              });
              orbsRing.appendChild(orbBtn);

              orbAnimators.push({
                emotionId: emotion.id,
                el: orbBtn,
                angle: (orbIndex * Math.PI * 2) / storyCount + idx * 0.65,
                baseSpeed: 0.34 + idx * 0.025,
                rx: emotion.orbitRadiusX,
                ry: emotion.orbitRadiusY,
              });
            });

            btn.addEventListener('pointerenter', () => {
              state.hoveredId = emotion.id;
            });
            btn.addEventListener('pointerleave', () => {
              if (state.hoveredId === emotion.id) {
                state.hoveredId = null;
              }
            });
            btn.addEventListener('pointerdown', () => {
              triggerTapBurst(btn);
            });
            btn.addEventListener('click', () => {
              triggerTapBurst(btn);
              selectEmotion(emotion.id);
            });

            cluster.appendChild(btn);
            cluster.appendChild(label);
            cluster.appendChild(orbsRing);
            skyStage.appendChild(cluster);
            clusterNodes.set(emotion.id, { cluster, btn });
          });
        }

        function renderEmotionDock() {
          emotionDock.innerHTML = '';
          ANGE_STORY_DATA.emotions.forEach((emotion) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'dock-btn';
            btn.style.setProperty('--btn-color', emotion.color);
            btn.style.setProperty('--btn-glow', emotion.glow);
            btn.setAttribute('aria-pressed', String(state.selectedId === emotion.id));
            btn.innerHTML = `
              <span class="dock-dot" aria-hidden="true"></span>
              <span>${emotion.name}</span>
            `;
            btn.addEventListener('click', () => {
              const target = clusterNodes.get(emotion.id);
              if (target) triggerTapBurst(target.btn);
              selectEmotion(emotion.id);
            });
            emotionDock.appendChild(btn);
            dockNodes.set(emotion.id, btn);
          });
        }

        function renderEmotionPanel() {
          const emotion = getEmotion(state.selectedId);
          emotionPanel.style.setProperty('--emotion-color', emotion.color);
          emotionPanel.style.setProperty('--emotion-glow', emotion.glow);
          emotionPanel.style.setProperty('--emotion-soft', emotion.softText);

          const storiesHtml = emotion.stories
            .map((story) => {
              const isRead = state.readStoryIds.includes(story.id);
              const partnerTag = story.partnerName
                ? `<span>${ANGE_STORY_DATA.texts.mixedOrbLabel} · ${emotion.name} &amp; ${story.partnerName}</span>`
                : '';
              const doneTag = isRead
                ? `<span class="story-tag-done">✓ ${ANGE_STORY_DATA.texts.readDoneLabel}</span>`
                : '';
              return `
                <button type="button" class="story-card-btn" data-open-story="${story.id}">
                  <img src="${story.orbImage}" alt="" class="story-orb-img" />
                  <div class="story-card-meta">
                    <h4 class="story-card-title">${story.title}</h4>
                    <p class="story-card-summary">${story.summary}</p>
                    <div class="story-card-tags">
                      <span>${story.durationMinutes} min</span>
                      ${partnerTag}
                      ${doneTag}
                    </div>
                  </div>
                  <span class="story-open-cta">${ANGE_STORY_DATA.texts.openStoryLabel}</span>
                </button>
              `;
            })
            .join('');

          const ritualHtml = emotion.ritualSteps
            .map((step) => `<li>${step}</li>`)
            .join('');

          emotionPanel.innerHTML = `
            <div class="panel-grid">
              <div>
                <div class="panel-emotion-head">
                  <img src="${emotion.image}" alt="${emotion.name} — ${emotion.characterName}" class="panel-planet-thumb" />
                  <div>
                    <span class="panel-kicker">${elidePlaneteOf(emotion.characterName)} · ${emotion.clock}</span>
                    <h2 class="panel-title">${emotion.name}</h2>
                  </div>
                </div>
                <p class="panel-feeling">${emotion.sentence}</p>
                <div class="whisper-box">${emotion.angeWhisper}</div>
                <div class="papote-card">
                  <div class="papote-badge">${ANGE_STORY_DATA.texts.papoteHeading}</div>
                  <p class="papote-question">${emotion.papoteQuestion}</p>
                </div>
                <div class="ritual-card">
                  <h3 class="ritual-title">${ANGE_STORY_DATA.texts.ritualHeading} : ${emotion.ritualTitle}</h3>
                  <ol class="ritual-steps">${ritualHtml}</ol>
                </div>
              </div>
              <div>
                ${(emotion.histoiresClement || []).map((h) => `
                  <a class="grande-histoire" href="${h.lien}">
                    <img src="/img/ange-couverture.webp" alt="" />
                    <span><small>${ANGE_STORY_DATA.texts.grandeHistoireLabel}</small><strong>${h.titre}</strong><em>${h.texte}</em></span>
                  </a>`).join('')}
                <h3 class="stories-heading">${ANGE_STORY_DATA.texts.storiesHeading}</h3>
                <div class="story-list">${storiesHtml}</div>
              </div>
            </div>
          `;

          emotionPanel.querySelectorAll('[data-open-story]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const storyId = btn.getAttribute('data-open-story');
              const story = emotion.stories.find((s) => s.id === storyId);
              if (story) openStoryModal(emotion, story);
            });
          });
        }

        function syncSelectedUI() {
          clusterNodes.forEach(({ cluster, btn }, id) => {
            const isSel = id === state.selectedId;
            cluster.classList.toggle('is-selected', isSel);
            btn.setAttribute('aria-pressed', String(isSel));
          });
          dockNodes.forEach((btn, id) => {
            const isSel = id === state.selectedId;
            btn.classList.toggle('is-selected', isSel);
            btn.setAttribute('aria-pressed', String(isSel));
          });
          document.querySelectorAll('.orb-btn').forEach((orbEl) => {
            const sid = orbEl.getAttribute('data-story-id');
            orbEl.classList.toggle('is-read', Boolean(sid && state.readStoryIds.includes(sid)));
          });
        }

        function selectEmotion(id) {
          state.selectedId = id;
          syncSelectedUI();
          renderWindRibbons();
          renderEmotionPanel();
        }

        function stopSpeech() {
          if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
          }
          readerSpeakBtn.textContent = ANGE_STORY_DATA.texts.speakStartLabel;
        }

        function updateReaderView() {
          const { activeStory, activeEmotion, pageIndex } = state;
          if (!activeStory || !activeEmotion) return;

          const total = activeStory.pages.length;
          const isLast = pageIndex >= total - 1;
          readerOrbImg.src = activeStory.orbImage;
          readerKicker.textContent = activeStory.partnerName
            ? `${activeEmotion.name} & ${activeStory.partnerName} · ${activeStory.durationMinutes} min`
            : `${activeEmotion.name} (${activeEmotion.characterName}) · ${activeStory.durationMinutes} min`;
          readerTitle.textContent = activeStory.title;
          readerPageText.textContent = activeStory.pages[pageIndex];
          readerPageCounter.textContent = `Page ${pageIndex + 1} / ${total}`;

          if (isLast) {
            readerClosing.hidden = false;
            readerClosing.textContent = `Chuchotement d’Ange : ${activeStory.closingWhisper}`;
            readerNextBtn.textContent = ANGE_STORY_DATA.texts.finishStoryLabel;
            readerNextBtn.classList.add('is-finish');
          } else {
            readerClosing.hidden = true;
            readerNextBtn.textContent = ANGE_STORY_DATA.texts.nextPageLabel;
            readerNextBtn.classList.remove('is-finish');
          }
          readerPrevBtn.disabled = pageIndex === 0;
        }

        function openStoryModal(emotion, story) {
          stopSpeech();
          state.activeEmotion = emotion;
          state.activeStory = story;
          state.pageIndex = 0;
          updateReaderView();
          if (typeof storyDialog.showModal === 'function') {
            if (!storyDialog.open) storyDialog.showModal();
          } else {
            storyDialog.setAttribute('open', 'open');
          }
        }

        function closeStoryModal() {
          stopSpeech();
          if (storyDialog.open && typeof storyDialog.close === 'function') {
            storyDialog.close();
          } else {
            storyDialog.removeAttribute('open');
          }
        }

        readerPrevBtn.addEventListener('click', () => {
          if (state.pageIndex > 0) {
            stopSpeech();
            state.pageIndex -= 1;
            updateReaderView();
          }
        });

        readerNextBtn.addEventListener('click', () => {
          if (!state.activeStory) return;
          stopSpeech();
          if (state.pageIndex < state.activeStory.pages.length - 1) {
            state.pageIndex += 1;
            updateReaderView();
          } else {
            if (!state.readStoryIds.includes(state.activeStory.id)) {
              state.readStoryIds.push(state.activeStory.id);
              saveReadStories();
              updateProgressChip();
              syncSelectedUI();
              renderEmotionPanel();
            }
            closeStoryModal();
          }
        });

        readerSpeakBtn.addEventListener('click', () => {
          if (!('speechSynthesis' in window) || !state.activeStory) return;
          if (window.speechSynthesis.speaking) {
            stopSpeech();
            return;
          }
          const utterance = new SpeechSynthesisUtterance(state.activeStory.pages[state.pageIndex]);
          utterance.lang = 'fr-FR';
          utterance.rate = 0.92;
          utterance.onend = () => {
            readerSpeakBtn.textContent = ANGE_STORY_DATA.texts.speakStartLabel;
          };
          readerSpeakBtn.textContent = ANGE_STORY_DATA.texts.speakStopLabel;
          window.speechSynthesis.speak(utterance);
        });

        readerCloseBtn.addEventListener('click', closeStoryModal);
        storyDialog.addEventListener('close', stopSpeech);

        bedtimeBtn.addEventListener('click', () => {
          const targetId = ANGE_STORY_DATA.texts.bedtimeStoryId;
          for (const em of ANGE_STORY_DATA.emotions) {
            const st = em.stories.find((s) => s.id === targetId);
            if (st) {
              selectEmotion(em.id);
              openStoryModal(em, st);
              return;
            }
          }
        });

        /* ========================================================================
           ORBITES CONTINUES DES ORBES (ACCELERE AU SURVOL/TAP, FIGE SI REDUCE MOTION)
           ======================================================================== */
        let lastTs = performance.now();
        let orbRafId = null;

        function positionOrbs(dt, reduce) {
          const isMobile = window.innerWidth <= 767;
          const scaleFactor = isMobile ? 0.8 : Math.min(1.05, skyStage.clientWidth / 1050);
          for (let i = 0; i < orbAnimators.length; i++) {
            const orb = orbAnimators[i];
            if (!reduce && dt > 0) {
              const isBoosted =
                state.hoveredId === orb.emotionId || state.selectedId === orb.emotionId;
              const speedMult = isBoosted ? (state.hoveredId === orb.emotionId ? 3.2 : 1.75) : 1;
              orb.angle += orb.baseSpeed * speedMult * dt;
            }
            const x = Math.cos(orb.angle) * orb.rx * scaleFactor;
            const y = Math.sin(orb.angle) * orb.ry * scaleFactor;
            orb.el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
          }
        }

        function animateOrbs(now) {
          const dt = Math.min(0.05, (now - lastTs) / 1000);
          lastTs = now;
          if (reduceMotionQuery.matches) {
            positionOrbs(0, true);
            orbRafId = null;
            return;
          }
          positionOrbs(dt, false);
          orbRafId = window.requestAnimationFrame(animateOrbs);
        }

        function startOrStopOrbLoop() {
          if (reduceMotionQuery.matches) {
            if (orbRafId !== null) {
              window.cancelAnimationFrame(orbRafId);
              orbRafId = null;
            }
            positionOrbs(0, true);
          } else if (orbRafId === null) {
            lastTs = performance.now();
            orbRafId = window.requestAnimationFrame(animateOrbs);
          }
        }

        reduceMotionQuery.addEventListener('change', startOrStopOrbLoop);
        window.addEventListener('resize', () => {
          if (reduceMotionQuery.matches) positionOrbs(0, true);
        });

        renderSkyPlanets();
        renderEmotionDock();
        syncSelectedUI();
        renderWindRibbons();
        renderEmotionPanel();
        updateProgressChip();
        startOrStopOrbLoop();
      })();
    
  </script>
</Base>
