---
/**
 * Le jardin des émotions : choisir une histoire selon ce qu'on ressent.
 * Design et mini-histoires générés avec AI Studio (26/11), adaptés au site : images dans public/emotions/,
 * style dans styles/jardin-emotions.css (tout est préfixé par .jardin).
 * Les textes, questions papote, rituels et mini-histoires se modifient dans ANGE_STORY_DATA, en haut du script.
 * histoiresClement : les vraies histoires du samedi rattachées à une émotion.
 */
import Base from '../layouts/Base.astro';
import '../styles/jardin-emotions.css';
---
<Base titre="Le jardin des émotions · Clémi Raconte" description="Comment tu te sens ce soir ? Choisis une planète, rencontre son gardien et trouve l’histoire qui va avec ton émotion." fond="aucun">
  <div class="jardin">

    <header class="site-header">
      <div class="brand-lockup">
        <div class="brand-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            <path d="M19 3v4" />
            <path d="M21 5h-4" />
          </svg>
        </div>
        <div>
          <h1 class="brand-title" id="site-title"></h1>
          <p class="brand-subtitle" id="site-subtitle"></p>
        </div>
      </div>

      <div class="header-actions">
        <div class="progress-chip" aria-live="polite">
          <span class="dot" aria-hidden="true"></span>
          <span id="progress-label">0 / 21 histoires écoutées</span>
        </div>
        <button type="button" class="btn-night-story" id="btn-bedtime-story">
          Histoire du soir
        </button>
      </div>
    </header>

    <main class="app-main">
      <section class="sky-frame" id="sky-stage" aria-label="Le ciel étoilé des émotions d'Ange">
        <img
          src="/emotions/sky-bg.webp"
          alt=""
          class="sky-bg-img"
          aria-hidden="true"
        />

        <div class="shooting-star-wrap" aria-hidden="true">
          <img src="/emotions/shooting-star.webp" alt="" />
        </div>

        <svg
          class="wind-ribbons-svg"
          viewBox="0 0 1376 768"
          preserveAspectRatio="none"
          aria-hidden="true"
          id="wind-ribbons-svg"
        ></svg>

        <div class="ange-stage-el" id="ange-el">
          <div class="ange-visual">
            <img src="/emotions/ange.webp" alt="Ange le petit loup assis sur sa lune moussue" class="ange-sprite" />
            <img src="/emotions/ange.webp" alt="" aria-hidden="true" class="ange-ears-layer" />
          </div>
          <p class="ange-prompt-caption" id="ange-caption"></p>
        </div>
      </section>

      <nav class="emotion-dock" id="emotion-dock" aria-label="Accès rapide aux sept émotions"></nav>

      <section class="emotion-panel" id="emotion-panel" aria-live="polite"></section>
    </main>

    <dialog class="reader-dialog" id="story-dialog" aria-labelledby="reader-title">
      <div class="reader-inner">
        <div class="reader-top">
          <div class="reader-top-left">
            <img id="reader-orb-img" src="/emotions/orb-joie.webp" alt="" />
            <div>
              <p class="reader-kicker" id="reader-kicker"></p>
              <h2 class="reader-title" id="reader-title"></h2>
            </div>
          </div>
          <button type="button" class="reader-close-btn" id="reader-close" aria-label="Fermer l'histoire">
            &times;
          </button>
        </div>

        <div class="reader-page-box">
          <p class="reader-page-text" id="reader-page-text"></p>
          <p class="reader-closing" id="reader-closing" hidden></p>
        </div>

        <div class="reader-controls">
          <button type="button" class="btn-secondary" id="reader-speak-btn">
            Lire à voix haute
          </button>
          <div class="reader-nav-group">
            <button type="button" class="btn-secondary" id="reader-prev-btn">Précédent</button>
            <span id="reader-page-counter" style="font-size: 0.9rem; font-weight: 600;"></span>
            <button type="button" class="btn-primary" id="reader-next-btn">Suivant</button>
          </div>
        </div>
      </div>
    </dialog>

    
  </div>
