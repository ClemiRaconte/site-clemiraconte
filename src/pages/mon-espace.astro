---
/**
 * Mon espace : la vraie bibliothèque de l'abonné connecté.
 * Mise en page validée par Clément le 26/11 : le décor peint reste en grand, les histoires sont des couvertures
 * posées sur une étagère en bas, l'histoire s'ouvre dans un panneau à onglets, le décor se change depuis la pastille du haut.
 * Les données arrivent de la fonction Netlify « mes-histoires », qui applique la règle d'accès.
 * La visite de démonstration reste sur /espace-abonne.
 */
import Base from '../layouts/Base.astro';
import DecorsAbonne from '../components/abonne/DecorsAbonne.astro';
import Logo from '../components/logo/Logo.astro';
import Lune from '../components/Lune.astro';
import '../styles/visionneuse.css';
import { u } from '../lib/url';
import { LIVRES } from '../data/livres';
const portail = import.meta.env.PUBLIC_STRIPE_PORTAIL ?? '';
const decors = [{id: 'feu', nom: 'Le feu de camp'}, {id: 'refuge', nom: 'Le refuge'}, {id: 'clairiere', nom: 'La clairière de la Daillon Party'}, {id: 'bateau', nom: 'Le bateau-bibliothèque'}, {id: 'lac', nom: 'Le lac de montagne'}, {id: 'jardin', nom: 'Le jardin'}, {id: 'cabane', nom: 'La cabane'}, {id: 'chambre', nom: 'La chambre'}, {id: 'ciel', nom: 'Le ciel'}];
const reglages = JSON.stringify({ livres: LIVRES, base: u('/'), decors });
---
<Base visionneuse nu titre="Mon espace · Clémi Raconte" description="Votre bibliothèque Clémi Raconte : vos histoires, leurs fiches papote et leurs activités.">
  <script is:inline>try{var d=localStorage.getItem('clemi-decor');if(['foret','mer'].indexOf(d)>=0)d=null;if(d)document.documentElement.classList.add('decor-'+d)}catch(e){}</script>
  <script is:inline type="application/json" id="me-reglages" set:html={reglages} />
  <DecorsAbonne />

  <header class="me-barre">
    <a class="me-logo" href={u('/')} aria-label="Clémi Raconte, revenir au site"><Logo taille={34} /></a>
    <nav class="me-onglets" role="tablist" aria-label="Mon espace" hidden>
      <button type="button" role="tab" aria-selected="true" data-vue="biblio">Ma bibliothèque</button>
      <button type="button" role="tab" aria-selected="false" data-vue="compte">Mon compte</button>
    </nav>
    <div class="me-barre-droite">
      <Lune clair />
      <button type="button" class="me-pastille" id="me-pastille" aria-controls="me-tiroir" aria-expanded="false">
        <span class="me-pastille-vue" id="me-pastille-vue"></span>
        <span class="me-pastille-texte"><small>Changer de décor</small><b id="me-pastille-nom">Choisir</b></span>
      </button>
      <a class="me-retour-site" href={u('/')}>Revenir au site</a>
    </div>
  </header>

  <div class="me-scene">
    <div class="me-accueil">
      <div class="me-tete">
        <p class="me-sur">Mon espace</p>
        <h1 id="me-bonjour">Bonjour</h1>
        <p class="me-samedi"><b>Samedi 9h</b> Une nouvelle histoire t’attend</p>
      </div>
      <aside class="me-une" id="me-une" hidden>
        <img id="me-une-couv" alt="" width="96" height="120" />
        <div>
          <small id="me-une-sur">L’histoire de la semaine</small>
          <h2 id="me-une-titre"></h2>
          <div class="me-actions" id="me-une-actions"></div>
        </div>
      </aside>
    </div>

    <p id="me-etat" class="me-etat" role="status">Ouverture de votre espace…</p>
    <p id="me-ouvert" class="me-note" hidden>Avant-première : l’espace se visite librement jusqu’au lancement du 12 décembre. Ensuite, il sera réservé aux abonnés. <a href={u('/abonnement')}>Choisir une formule</a></p>
    <p id="me-pas-abonne" class="me-note" hidden>Vous n’avez pas d’abonnement en cours avec cette adresse. Ange vous est offert, et les histoires reçues pendant vos abonnements passés restent ici. <a href={u('/abonnement')}>Choisir une formule</a></p>

    <section class="vue me-biblio" data-vue="biblio" hidden aria-labelledby="me-biblio-titre">
      <div class="me-etagere-titre"><h2 id="me-biblio-titre">Ma bibliothèque</h2><span id="me-nb"></span></div>
      <ul id="me-etagere" class="me-rang"></ul>
      <div class="me-planche" aria-hidden="true"></div>
    </section>

    <section class="vue me-compte" data-vue="compte" hidden>
      <h2>Mon compte</h2>
      <section class="me-bloc">
        <h3>Ma formule</h3>
        <ul id="me-formules" class="me-liste"></ul>
      </section>
      <section class="me-bloc">
        <h3>Mon adresse de connexion</h3>
        <p id="me-email"></p>
      </section>
      <section class="me-bloc">
        <h3>Mes factures et mon abonnement</h3>
        <p>Vos factures, votre moyen de paiement et l’arrêt de la formule au mois se gèrent dans votre espace de paiement sécurisé</p>
        {portail
          ? <a class="btn btn-contour" href={portail} rel="noopener">Gérer mon abonnement</a>
          : <p class="me-note">Ce lien s’ouvrira avec les premiers paiements</p>}
      </section>
      <p class="me-note"><strong>Un accès, c’est une famille.</strong> Votre accès est personnel : merci de ne pas le partager. C’est ce qui permet aux histoires de continuer d’exister</p>
      <button type="button" class="btn btn-contour" id="me-deconnexion">Me déconnecter</button>
    </section>
  </div>

  <!-- Tiroir des décors -->
  <div class="me-tiroir" id="me-tiroir" aria-hidden="true" inert>
    <div class="me-tiroir-tete">
      <div>
        <h2>Où veux-tu écouter tes histoires aujourd’hui ?</h2>
        <p>Le décor suit la saison et passe en nuit à 20h. Tu pourras en changer quand tu veux</p>
      </div>
      <button type="button" class="me-fermer" id="me-fermer-tiroir" aria-label="Fermer les décors">×</button>
    </div>
    <ul class="me-portes">
      {decors.map((d, i) => (
        <li style={`--i:${i}`}><button type="button" class={`me-porte porte-${d.id}`} data-decor={d.id} aria-pressed="false"><span class="me-porte-vue"></span><b>{d.nom}</b></button></li>
      ))}
    </ul>
  </div>

  <!-- L'histoire ouverte, comme un livre posé sur le décor -->
  <div class="me-voile" id="me-voile"></div>
  <article id="me-histoire" class="me-histoire" role="dialog" aria-modal="true" aria-labelledby="me-h-titre" aria-hidden="true" inert>
    <div class="me-h-image" id="me-h-image">
      <button type="button" class="me-fermer" data-retour aria-label="Revenir à ma bibliothèque">×</button>
      <div class="me-h-titre"><small id="me-h-theme"></small><h2 id="me-h-titre"></h2></div>
    </div>
    <div id="me-h-ages" class="me-ages"></div>
    <nav class="me-h-onglets" role="tablist" aria-label="L’histoire">
      <button type="button" role="tab" data-o="lire" aria-selected="true">Lire</button>
      <button type="button" role="tab" data-o="ecouter" aria-selected="false">Écouter</button>
      <button type="button" role="tab" data-o="regarder" aria-selected="false">Regarder</button>
      <button type="button" role="tab" data-o="papoter" aria-selected="false">Papoter</button>
      <button type="button" role="tab" data-o="activites" aria-selected="false">Activités</button>
    </nav>
    <div class="me-h-corps">
      <div class="me-h-vue" data-o="lire"><div id="me-h-lecture"></div></div>
      <div class="me-h-vue" data-o="ecouter" id="me-h-audio" hidden>
        <div class="me-ecoute">
          <button type="button" class="me-enceinte" aria-label="Écouter l’histoire">
            <span class="me-hp"><i></i></span><span class="me-hp-play" aria-hidden="true"></span>
            <span class="me-ondes" aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
          <p>Racontée par Clément. Idéal pour la voiture, ou les yeux fermés avant de dormir</p>
        </div>
        <audio preload="none" controls></audio>
      </div>
      <div class="me-h-vue" data-o="regarder" id="me-h-video" hidden><div class="me-video"></div><p class="me-intro">La vidéo, racontée dans la forêt conteuse</p></div>
      <div class="me-h-vue" data-o="papoter" hidden>
        <p class="me-intro">La fiche papote propose des questions pour en parler après, sans faire la leçon</p>
        <div id="me-h-papote"></div>
      </div>
      <div class="me-h-vue" data-o="activites" hidden>
        <p class="me-intro">Elles se téléchargent et s’impriment, une par une</p>
        <ul id="me-h-activites" class="me-activites"></ul>
        <div id="me-h-bonus-bloc" hidden>
          <h3>Les activités bonus</h3>
          <ul id="me-h-bonus" class="me-activites"></ul>
        </div>
      </div>
    </div>
  </article>
</Base>

<script>
  import { branche, sb, maBibliotheque } from '../lib/abonne';
  import { formules, famillesElargies } from '../data/formules';

  const $ = (id: string) => document.getElementById(id)!;
  const R = JSON.parse($('me-reglages').textContent || '{}') as { livres: Record<string, { n: number; r: number; l: number[] }>; base: string; decors: { id: string; nom: string }[] };
  const chemin = (p: string) => R.base.replace(/\/$/, '') + p;
  const etat = $('me-etat');
  const connexion = new URL('connexion.html', location.href).href;
  const nomFormule = (id: string) => {
    const f = formules.find((x) => x.id === id);
    if (f) return `${f.nom}, ${f.prix} ${f.periode}`;
    const e = famillesElargies.find((x) => x.id === id);
    return e ? `Famille élargie, ${e.nom}, ${e.prix} / an` : id;
  };
  const date = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const dateCourte = (d: string) => new Date(d).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
  const texte = (t: string) => { const s = document.createElement('span'); s.textContent = t; return s.innerHTML; };

  type Act = { titre: string; type: string; pdf: string | null };
  type Adapt = { texte: unknown; histoire: string | null; papote: string | null; activites: Act[]; bonus: Act[] };
  type Histoire = { slug: string; titre: string; theme: string | null; date_sortie: string; a_venir?: boolean; video: string | null; audio?: string | null; adaptations: Record<string, Adapt> };

  // ---------- Couvertures ----------
  const COUV_SPECIALES: Record<string, { couv: string; interieur: string; r: number }> = {
    'ange-le-loup': { couv: '/img/ange-couverture.webp', interieur: '/img/ange-interieur.webp', r: 1.24 },
  };
  const AUDIOS: Record<string, string> = { 'ange-le-loup': '/ange-le-loup.mp3' };
  function couverture(h: Histoire) {
    const s = COUV_SPECIALES[h.slug];
    if (s) return `<img src="${chemin(s.couv)}" alt="" loading="lazy" />`;
    const l = h.theme ? R.livres[h.theme] : undefined;
    if (l) return `<img src="${chemin(`/livres/livre-${l.n}.webp`)}" alt="" loading="lazy" /><span class="me-livre-t" style="left:${l.l[0]}%;top:${l.l[1]}%;width:${l.l[2]}%;height:${l.l[3]}%">${texte(h.titre)}</span>`;
    return `<span class="me-livre-uni"><strong>${texte(h.titre)}</strong></span>`;
  }
  const ratio = (h: Histoire) => COUV_SPECIALES[h.slug]?.r ?? (h.theme && R.livres[h.theme]?.r) ?? 1.3;
  const imageCouv = (h: Histoire) => COUV_SPECIALES[h.slug]?.couv ?? (h.theme && R.livres[h.theme] ? `/livres/livre-${R.livres[h.theme].n}.webp` : '');

  // ---------- Vues bibliothèque / compte ----------
  function montrer(vue: string) {
    document.querySelectorAll<HTMLElement>('.vue').forEach((v) => (v.hidden = v.dataset.vue !== vue));
    document.querySelectorAll<HTMLButtonElement>('.me-onglets button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.vue === vue)));
    document.body.dataset.vue = vue;
  }

  // ---------- Tiroir des décors ----------
  const tiroir = $('me-tiroir'), pastille = $('me-pastille') as HTMLButtonElement;
  function tiroirOuvert(o: boolean) {
    tiroir.classList.toggle('ouvert', o);
    tiroir.setAttribute('aria-hidden', String(!o));
    tiroir.toggleAttribute('inert', !o);
    pastille.setAttribute('aria-expanded', String(o));
    if (o) tiroir.querySelector<HTMLElement>('[aria-pressed="true"], .me-porte')?.focus({ preventScroll: true });
  }
  function decorActuel() {
    let d: string | null = null;
    try { d = localStorage.getItem('clemi-decor'); if (d === 'foret' || d === 'mer') d = null; } catch {}
    return d;
  }
  function majPastille() {
    const d = decorActuel();
    $('me-pastille-nom').textContent = R.decors.find((x) => x.id === d)?.nom ?? 'Choisir';
    const vue = d ? document.querySelector<HTMLElement>(`[data-decor="${d}"] .me-porte-vue`) : null;
    $('me-pastille-vue').style.backgroundImage = vue?.style.backgroundImage ?? '';
    document.querySelectorAll<HTMLButtonElement>('[data-decor]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.decor === d)));
  }
  pastille.onclick = () => tiroirOuvert(!tiroir.classList.contains('ouvert'));
  $('me-fermer-tiroir').onclick = () => { tiroirOuvert(false); pastille.focus(); };
  document.querySelectorAll<HTMLButtonElement>('[data-decor]').forEach((b) => (b.onclick = () => {
    const d = b.dataset.decor!;
    document.documentElement.className = document.documentElement.className.replace(/\bdecor-\S+/g, '').trim();
    document.documentElement.classList.add(`decor-${d}`);
    try { localStorage.setItem('clemi-decor', d); } catch {}
    majPastille();
  }));
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (tiroir.classList.contains('ouvert') && !tiroir.contains(t) && !pastille.contains(t)) tiroirOuvert(false);
  });

  // ---------- L'histoire ouverte ----------
  const panneau = $('me-histoire'), voile = $('me-voile');
  let ouverte: { h: Histoire; age: string } | null = null;
  let monte: Record<string, boolean> = {};
  let dernierFocus: HTMLElement | null = null;
  const son = $('me-h-audio').querySelector('audio')!;
  const hp = $('me-h-audio').querySelector<HTMLButtonElement>('.me-enceinte')!;

  function visionneuse(conteneur: HTMLElement, docs: unknown[], idTexte?: string, texteJson?: unknown) {
    conteneur.innerHTML = '';
    if (!docs.length) { conteneur.innerHTML = '<p class="me-intro">Bientôt disponible</p>'; return; }
    if (idTexte && texteJson) {
      const s = document.createElement('script');
      s.type = 'application/json'; s.id = idTexte; s.textContent = JSON.stringify(texteJson);
      conteneur.appendChild(s);
    }
    const vz = document.createElement('div');
    vz.className = 'vz';
    vz.dataset.docs = JSON.stringify(docs);
    vz.dataset.pied = 'Lecture en ligne. L’histoire et sa fiche papote restent dans votre espace';
    conteneur.appendChild(vz);
    (window as any).vzMonter?.(vz);
  }

  function onglet(o: string) {
    if (!ouverte) return;
    const { h, age } = ouverte, ad = h.adaptations[age];
    panneau.querySelectorAll<HTMLButtonElement>('.me-h-onglets button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.o === o)));
    panneau.querySelectorAll<HTMLElement>('.me-h-vue').forEach((v) => (v.hidden = v.dataset.o !== o));
    if (o !== 'ecouter') son.pause();
    if (o !== 'regarder') $('me-h-video').querySelector('.me-video')!.innerHTML = '';
    // La visionneuse mesure son cadre : on la monte quand son onglet est visible
    if (o === 'lire' && !monte.lire) {
      const id = `me-texte-${h.slug}-${age}`;
      visionneuse($('me-h-lecture'), ad.histoire ? [{ titre: 'L’histoire', src: ad.histoire, ...(ad.texte ? { texte: id } : {}) }] : [], id, ad.texte);
      monte.lire = true;
    }
    if (o === 'papoter' && !monte.papoter) { visionneuse($('me-h-papote'), ad.papote ? [{ titre: 'La fiche papote', src: ad.papote }] : []); monte.papoter = true; }
    if (o === 'regarder' && h.video) $('me-h-video').querySelector('.me-video')!.innerHTML = `<iframe loading="lazy" src="${h.video}" title="${texte(h.titre)}, en vidéo" allow="accelerometer; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
  }

  function ouvrirHistoire(h: Histoire, age?: string, o = 'lire') {
    const ages = Object.keys(h.adaptations).sort();
    if (!ages.length) return;
    const a = age && h.adaptations[age] ? age : ages[0];
    const ad = h.adaptations[a];
    ouverte = { h, age: a }; monte = {};
    $('me-h-titre').textContent = h.titre;
    $('me-h-theme').textContent = h.theme ?? '';
    const fond = COUV_SPECIALES[h.slug]?.interieur ?? imageCouv(h);
    $('me-h-image').style.backgroundImage = fond ? `url(${chemin(fond)})` : '';
    $('me-h-ages').innerHTML = ages.length > 1
      ? `<span>Version</span>${ages.map((x) => `<button type="button" aria-pressed="${x === a}" data-age="${x}">${x} ans</button>`).join('')}`
      : `<span>Version ${a} ans</span>`;
    $('me-h-ages').querySelectorAll<HTMLButtonElement>('button').forEach((b) => (b.onclick = () => {
      const actif = panneau.querySelector<HTMLButtonElement>('.me-h-onglets [aria-selected="true"]')?.dataset.o;
      ouvrirHistoire(h, b.dataset.age, actif);
    }));

    const liste = (acts: Act[]) => acts.map((x) => `<li>${x.pdf ? `<a href="${x.pdf}" target="_blank" rel="noopener">${texte(x.titre)}</a>` : `<b>${texte(x.titre)}</b>`}<span>${texte(x.type)}</span></li>`).join('');
    $('me-h-activites').innerHTML = liste(ad.activites);
    $('me-h-bonus').innerHTML = liste(ad.bonus);
    $('me-h-bonus-bloc').hidden = !ad.bonus.length;
    const audio = h.audio ?? AUDIOS[h.slug];
    son.pause(); $('me-h-audio').classList.remove('joue');
    if (audio && !son.src.endsWith(audio)) son.src = chemin(audio);
    // On cache les onglets sans contenu
    const dispo: Record<string, boolean> = { lire: Boolean(ad.histoire), ecouter: Boolean(audio), regarder: Boolean(h.video), papoter: Boolean(ad.papote), activites: Boolean(ad.activites.length || ad.bonus.length) };
    panneau.querySelectorAll<HTMLButtonElement>('.me-h-onglets button').forEach((b) => {
      b.hidden = !dispo[b.dataset.o!];
      if (b.dataset.o === 'activites') b.textContent = ad.activites.length ? `${ad.activites.length} activités` : 'Activités';
    });
    if (!dispo[o]) o = Object.keys(dispo).find((k) => dispo[k]) ?? 'lire';

    if (!panneau.classList.contains('ouvert')) {
      dernierFocus = document.activeElement as HTMLElement;
      panneau.classList.add('ouvert'); panneau.setAttribute('aria-hidden', 'false'); panneau.removeAttribute('inert');
      voile.classList.add('vu'); document.body.classList.add('me-livre-ouvert');
      tiroirOuvert(false);
      setTimeout(() => panneau.querySelector<HTMLElement>('[data-retour]')?.focus({ preventScroll: true }), 50);
    }
    onglet(o);
  }
  function fermerHistoire() {
    if (!panneau.classList.contains('ouvert')) return;
    son.pause();
    $('me-h-video').querySelector('.me-video')!.innerHTML = '';
    panneau.classList.remove('ouvert'); panneau.setAttribute('aria-hidden', 'true'); panneau.setAttribute('inert', '');
    voile.classList.remove('vu'); document.body.classList.remove('me-livre-ouvert');
    ouverte = null;
    dernierFocus?.focus({ preventScroll: true });
  }
  panneau.querySelectorAll<HTMLButtonElement>('.me-h-onglets button').forEach((b) => (b.onclick = () => onglet(b.dataset.o!)));
  panneau.querySelector<HTMLButtonElement>('[data-retour]')!.onclick = fermerHistoire;
  voile.onclick = fermerHistoire;
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { if (panneau.classList.contains('ouvert')) fermerHistoire(); else if (tiroir.classList.contains('ouvert')) { tiroirOuvert(false); pastille.focus(); } } });
  hp.onclick = () => (son.paused ? son.play() : son.pause());
  son.onplay = () => { $('me-h-audio').classList.add('joue'); hp.setAttribute('aria-label', 'Mettre en pause'); };
  son.onpause = son.onended = () => { $('me-h-audio').classList.remove('joue'); hp.setAttribute('aria-label', 'Écouter l’histoire'); };

  // ---------- Démarrage ----------
  function salut() { const h = new Date().getHours(); $('me-bonjour').textContent = h >= 18 || h < 5 ? 'Bonsoir' : 'Bonjour'; }

  function etagere(biblio: Histoire[]) {
    const parues = biblio.filter((h) => !h.a_venir);
    const avenir = biblio.filter((h) => h.a_venir).sort((a, b) => a.date_sortie.localeCompare(b.date_sortie));
    const recente = parues[0];
    const nouveau = recente && Date.now() - new Date(recente.date_sortie).getTime() < 7 * 864e5;
    $('me-nb').textContent = [parues.length ? `${parues.length} histoire${parues.length > 1 ? 's' : ''}` : '', avenir.length ? `${avenir.length} à venir` : ''].filter(Boolean).join(' · ');
    const livre = (h: Histoire, i: number, fermee: boolean) =>
      `<li><button type="button" class="me-livre${fermee ? ' me-a-venir' : ''}${!fermee && i === 0 && nouveau ? ' me-nouveau' : ''}" style="--r:${ratio(h)}" data-slug="${h.slug}"${fermee ? ` aria-disabled="true" data-date="${texte(dateCourte(h.date_sortie))}"` : ''} aria-label="${texte(h.titre)}${fermee ? `, sortie le ${texte(date(h.date_sortie))}` : ''}">${couverture(h)}${fermee ? '<span class="me-ruban"></span>' : ''}</button></li>`;
    $('me-etagere').innerHTML = parues.map((h, i) => livre(h, i, false)).join('') + avenir.map((h, i) => livre(h, i, true)).join('');
    $('me-etagere').querySelectorAll<HTMLButtonElement>('.me-livre:not(.me-a-venir)').forEach((b) => (b.onclick = () => ouvrirHistoire(biblio.find((h) => h.slug === b.dataset.slug)!)));

    // L'histoire de la semaine (ou la prochaine à paraître)
    const une = recente ?? avenir[0];
    if (une) {
      $('me-une').hidden = false;
      ($('me-une-couv') as HTMLImageElement).src = chemin(imageCouv(une) || '/img/ange-couverture.webp');
      $('me-une-titre').textContent = une.titre;
      $('me-une-sur').textContent = recente ? 'L’histoire de la semaine' : 'Bientôt dans ta bibliothèque';
      const actions = $('me-une-actions');
      if (recente) {
        const ad = recente.adaptations[Object.keys(recente.adaptations).sort()[0]];
        const btn = [ad?.histoire && ['lire', 'Lire'], (recente.audio ?? AUDIOS[recente.slug]) && ['ecouter', 'Écouter'], recente.video && ['regarder', 'Regarder']].filter(Boolean) as string[][];
        actions.innerHTML = btn.map(([o, t], i) => `<button type="button" class="${i === 0 ? 'fort' : ''}" data-o="${o}">${t}</button>`).join('');
        actions.querySelectorAll<HTMLButtonElement>('button').forEach((b) => (b.onclick = () => ouvrirHistoire(recente, undefined, b.dataset.o)));
      } else actions.innerHTML = `<span class="me-bientot">Sortie le ${texte(dateCourte(une.date_sortie))}</span>`;
    }
  }

  async function demarrer() {
    salut();
    if (!branche || !sb) { etat.textContent = 'L’espace ouvre avec les premières histoires. Vos accès vous arriveront par email'; return; }
    // Au retour du lien email, Supabase lit le jeton dans l'adresse : on lui laisse un instant.
    await sb.auth.getSession();
    const r = await maBibliotheque();
    if (r.erreur === 'non-connecte') { location.replace(connexion); return; }
    if (r.erreur) { etat.textContent = 'Votre espace ne répond pas pour le moment. Réessayez dans quelques minutes'; return; }
    const d = r.donnees as { email: string; ouvert?: boolean; abonne: boolean; periodes: { formule: string; debut: string; fin: string | null }[]; bibliotheque: Histoire[] };

    etat.hidden = true;
    (document.querySelector('.me-onglets') as HTMLElement).hidden = false;
    const monEmail = document.getElementById('me-email');
    if (monEmail) monEmail.textContent = d.email;
    $('me-pas-abonne').hidden = d.abonne || Boolean(d.ouvert && !d.email);
    $('me-ouvert').hidden = !(d.ouvert && !d.email);
    // Visite libre (sans compte) : on retire seulement « Mon compte »
    if (!d.email) document.querySelectorAll('[data-vue="compte"]').forEach((x) => x.remove());
    const mesFormules = document.getElementById('me-formules');
    if (mesFormules) mesFormules.innerHTML = d.periodes.length
      ? d.periodes.map((p) => `<li>${texte(nomFormule(p.formule))} : depuis le ${date(p.debut)}${p.fin ? (new Date(p.fin) > new Date() ? `, jusqu’au ${date(p.fin)}` : `, terminée le ${date(p.fin)}`) : p.formule === 'famille-mois' ? ', sans engagement' : ', renouvelée chaque année'}</li>`).join('')
      : '<li>Aucune formule pour le moment</li>';
    etagere(d.bibliotheque);
    montrer('biblio');
    // Première visite : on propose tout de suite de choisir un décor
    if (!decorActuel()) tiroirOuvert(true);
  }

  document.querySelectorAll<HTMLButtonElement>('.me-onglets button').forEach((b) => (b.onclick = () => montrer(b.dataset.vue!)));
  $('me-deconnexion').onclick = async () => { await sb?.auth.signOut(); location.replace(connexion); };
  requestAnimationFrame(majPastille);
  demarrer();
</script>

