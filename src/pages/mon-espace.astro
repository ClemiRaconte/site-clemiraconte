---
/**
 * Mon espace : la vraie bibliothèque de l'abonné connecté.
 * Fond seulement (structure et fonctionnement) : la mise en forme fine reste à habiller.
 * Les données arrivent de la fonction Netlify « mes-histoires », qui applique la règle d'accès.
 * La visite de démonstration reste sur /espace-abonne.
 */
import Base from '../layouts/Base.astro';
import DecorsAbonne from '../components/abonne/DecorsAbonne.astro';
import Logo from '../components/logo/Logo.astro';
import '../styles/visionneuse.css';
import { u } from '../lib/url';
const portail = import.meta.env.PUBLIC_STRIPE_PORTAIL ?? '';
const decors = [{id: 'feu', nom: 'Le feu de camp'}, {id: 'refuge', nom: 'Le refuge'}, {id: 'clairiere', nom: 'La clairière de la Daillon Party'}, {id: 'bateau', nom: 'Le bateau-bibliothèque'}, {id: 'lac', nom: 'Le lac de montagne'}, {id: 'jardin', nom: 'Le jardin'}, {id: 'cabane', nom: 'La cabane'}, {id: 'chambre', nom: 'La chambre'}, {id: 'ciel', nom: 'Le ciel'}];
---
<Base visionneuse nu titre="Mon espace · Clémi Raconte" description="Votre bibliothèque Clémi Raconte : vos histoires, leurs fiches papote et leurs activités.">
  <script is:inline>try{var d=localStorage.getItem('clemi-decor');if(['foret','mer'].indexOf(d)>=0)d=null;if(d)document.documentElement.classList.add('decor-'+d)}catch(e){}</script>
  <DecorsAbonne />
  <header class="me-barre">
    <a class="me-logo" href={u('/')} aria-label="Clémi Raconte, revenir au site"><Logo taille={36} /></a>
    <nav class="me-onglets" role="tablist" aria-label="Mon espace" hidden>
      <button type="button" role="tab" aria-selected="true" data-vue="biblio">Ma bibliothèque</button>
      <button type="button" role="tab" aria-selected="false" data-vue="decors">Changer de décor</button>
      <button type="button" role="tab" aria-selected="false" data-vue="compte">Mon compte</button>
    </nav>
    <a class="me-retour-site" href={u('/')}>Revenir au site</a>
  </header>

  <div class="me-scene">
    <div class="me-tete">
      <p class="me-sur">Mon espace</p>
      <h1 id="me-bonjour">Bonjour</h1>
      <p class="me-samedi"><b>Samedi 9h</b> Une nouvelle histoire t’attend</p>
    </div>
    <p id="me-etat" class="me-etat" role="status">Ouverture de votre espace…</p>

    <div class="vue" data-vue="decors" hidden>
      <h2>Où veux-tu écouter tes histoires aujourd’hui ?</h2>
      <p class="me-intro">Choisis ton décor. Tu pourras en changer quand tu veux</p>
      <ul class="me-portes">
        {decors.map((d, i) => (
          <li style={`--i:${i}`}><button type="button" class={`me-porte porte-${d.id}`} data-decor={d.id}><span class="me-porte-vue"></span><b>{d.nom}</b></button></li>
        ))}
      </ul>
    </div>

    <div class="vue" data-vue="biblio" hidden>
      <h2>Ma bibliothèque</h2>
      <p class="me-intro">Une nouvelle histoire arrive chaque samedi à 9h. Tout ce que vous recevez reste dans votre bibliothèque</p>
      <p id="me-ouvert" class="me-note" hidden>Avant-première : l’espace se visite librement jusqu’au lancement du 12 décembre. Ensuite, il sera réservé aux abonnés. <a href={u('/abonnement')}>Choisir une formule</a></p>
      <p id="me-pas-abonne" class="me-note" hidden>Vous n’avez pas d’abonnement en cours avec cette adresse. Ange vous est offert, et les histoires reçues pendant vos abonnements passés restent ici. <a href={u('/abonnement')}>Choisir une formule</a></p>
      <ul id="me-etagere" class="me-etagere"></ul>

      <article id="me-histoire" class="me-histoire" hidden>
        <button type="button" class="lien-bouton" data-retour>← Retour à ma bibliothèque</button>
        <h2 id="me-h-titre"></h2>
        <div id="me-h-ages" class="me-ages"></div>
        <div id="me-h-lecture"></div>
        <h3>Les 12 activités à explorer</h3>
        <p class="me-intro">Elles se téléchargent et s’impriment, une par une</p>
        <ul id="me-h-activites" class="me-liste"></ul>
        <div id="me-h-bonus-bloc" hidden>
          <h3>Les activités bonus</h3>
          <ul id="me-h-bonus" class="me-liste"></ul>
        </div>
        <div id="me-h-audio" hidden>
          <h3>À écouter</h3>
          <button type="button" class="me-enceinte" aria-label="Écouter l’histoire">
            <span class="me-hp"><i></i></span><span class="me-hp-play" aria-hidden="true"></span>
            <span class="me-ondes" aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
          <audio preload="none"></audio>
        </div>
        <div id="me-h-video" hidden>
          <h3>À regarder</h3>
          <div class="me-video"></div>
        </div>
      </article>
    </div>

    <div class="vue" data-vue="compte" hidden>
      <h2>Mon compte</h2>
      <section class="me-bloc">
        <h3>Ma formule</h3>
        <ul id="me-formules" class="me-liste"></ul>
      </section>
      <section class="me-bloc">
        <h3>Mon adresse de connexion</h3>
        <p id="me-email"></p>
      </section>
      <section class="me-bloc">
        <h3>Mes factures et mon abonnement</h3>
        <p>Vos factures, votre moyen de paiement et l’arrêt de la formule au mois se gèrent dans votre espace de paiement sécurisé</p>
        {portail
          ? <a class="btn btn-contour" href={portail} rel="noopener">Gérer mon abonnement</a>
          : <p class="me-note">Ce lien s’ouvrira avec les premiers paiements</p>}
      </section>
      <p class="me-note"><strong>Un accès, c’est une famille.</strong> Votre accès est personnel : merci de ne pas le partager. C’est ce qui permet aux histoires de continuer d’exister</p>
      <button type="button" class="btn btn-contour" id="me-deconnexion">Me déconnecter</button>
    </div>
  </div>
</Base>

<script>
  import { branche, sb, maBibliotheque, ouvert } from '../lib/abonne';
  import { formules, famillesElargies } from '../data/formules';

  const $ = (id: string) => document.getElementById(id)!;
  const etat = $('me-etat');
  const connexion = new URL('connexion.html', location.href).href;
  const nomFormule = (id: string) => {
    const f = formules.find((x) => x.id === id);
    if (f) return `${f.nom}, ${f.prix} ${f.periode}`;
    const e = famillesElargies.find((x) => x.id === id);
    return e ? `Famille élargie, ${e.nom}, ${e.prix} / an` : id;
  };
  const date = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const texte = (t: string) => { const s = document.createElement('span'); s.textContent = t; return s.innerHTML; };

  type Act = { titre: string; type: string; pdf: string | null };
  type Adapt = { texte: unknown; histoire: string | null; papote: string | null; activites: Act[]; bonus: Act[] };
  type Histoire = { slug: string; titre: string; theme: string | null; date_sortie: string; a_venir?: boolean; video: string | null; adaptations: Record<string, Adapt> };

  function montrer(vue: string) {
    document.querySelectorAll<HTMLElement>('.vue').forEach((v) => (v.hidden = v.dataset.vue !== vue));
    document.querySelectorAll<HTMLButtonElement>('.me-onglets button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.vue === vue)));
  }

  function ouvrirHistoire(h: Histoire, age?: string) {
    const ages = Object.keys(h.adaptations).sort();
    const a = age && h.adaptations[age] ? age : ages[0];
    const ad = h.adaptations[a];
    $('me-etagere').hidden = true;
    $('me-histoire').hidden = false;
    $('me-h-titre').textContent = h.titre;
    $('me-h-ages').innerHTML = ages.length > 1
      ? ages.map((x) => `<button type="button" aria-pressed="${x === a}" data-age="${x}">${x} ans</button>`).join('')
      : `<p class="me-intro">Version ${a} ans</p>`;
    $('me-h-ages').querySelectorAll<HTMLButtonElement>('button').forEach((b) => (b.onclick = () => ouvrirHistoire(h, b.dataset.age)));

    // Visionneuse : l'histoire (en liseuse sur téléphone) et la fiche papote, en lecture seule.
    const lecture = $('me-h-lecture');
    lecture.innerHTML = '';
    const idTexte = `me-texte-${h.slug}-${a}`;
    if (ad.texte) {
      const s = document.createElement('script');
      s.type = 'application/json'; s.id = idTexte; s.textContent = JSON.stringify(ad.texte);
      lecture.appendChild(s);
    }
    const docs = [
      ad.histoire && { titre: 'L’histoire', src: ad.histoire, ...(ad.texte ? { texte: idTexte } : {}) },
      ad.papote && { titre: 'La fiche papote', src: ad.papote },
    ].filter(Boolean);
    const vz = document.createElement('div');
    vz.className = 'vz';
    vz.dataset.docs = JSON.stringify(docs);
    vz.dataset.pied = 'Lecture en ligne. L’histoire et sa fiche papote restent dans votre espace';
    lecture.appendChild(vz);
    (window as any).vzMonter?.(vz);

    const liste = (acts: Act[]) => acts.map((x) => `<li>${x.pdf ? `<a href="${x.pdf}" target="_blank" rel="noopener">${texte(x.titre)}</a>` : texte(x.titre)} <span>(${texte(x.type)})</span></li>`).join('');
    $('me-h-activites').innerHTML = liste(ad.activites);
    $('me-h-bonus').innerHTML = liste(ad.bonus);
    $('me-h-bonus-bloc').hidden = !ad.bonus.length;
    const AUDIOS: Record<string, string> = { 'ange-le-loup': '/ange-le-loup.mp3' };
    const bloc = $('me-h-audio'), son = bloc.querySelector('audio')!, hp = bloc.querySelector<HTMLButtonElement>('.me-enceinte')!;
    son.pause(); bloc.classList.remove('joue');
    bloc.hidden = !AUDIOS[h.slug];
    if (AUDIOS[h.slug]) {
      son.src = AUDIOS[h.slug];
      hp.onclick = () => (son.paused ? son.play() : son.pause());
      son.onplay = () => { bloc.classList.add('joue'); hp.setAttribute('aria-label', 'Mettre en pause'); };
      son.onpause = son.onended = () => { bloc.classList.remove('joue'); hp.setAttribute('aria-label', 'Écouter l’histoire'); };
    }
    $('me-h-video').hidden = !h.video;
    if (h.video) $('me-h-video').querySelector('.me-video')!.innerHTML = `<iframe loading="lazy" src="${h.video}" title="${texte(h.titre)}, en vidéo" allow="accelerometer; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    $('me-histoire').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function demarrer() {
    if (!branche || !sb) { etat.textContent = 'L’espace ouvre avec les premières histoires. Vos accès vous arriveront par email'; return; }
    // Au retour du lien email, Supabase lit le jeton dans l'adresse : on lui laisse un instant.
    await sb.auth.getSession();
    const r = await maBibliotheque();
    if (r.erreur === 'non-connecte') { location.replace(connexion); return; }
    if (r.erreur) { etat.textContent = 'Votre espace ne répond pas pour le moment. Réessayez dans quelques minutes'; return; }
    const d = r.donnees as { email: string; abonne: boolean; periodes: { formule: string; debut: string; fin: string | null }[]; bibliotheque: Histoire[] };

    etat.hidden = true;
    (document.querySelector('.me-onglets') as HTMLElement).hidden = false;
    $('me-email').textContent = d.email;
    $('me-pas-abonne').hidden = d.abonne || (d.ouvert && !d.email);
    $('me-ouvert').hidden = !(d.ouvert && !d.email);
    // Sans compte (avant-première) : on retire seulement « Mon compte », le choix du décor reste.
    if (!d.email) document.querySelectorAll('[data-vue="compte"]').forEach((x) => x.remove());
    $('me-formules').innerHTML = d.periodes.length
      ? d.periodes.map((p) => `<li>${texte(nomFormule(p.formule))} : depuis le ${date(p.debut)}${p.fin ? (new Date(p.fin) > new Date() ? `, jusqu’au ${date(p.fin)}` : `, terminée le ${date(p.fin)}`) : p.formule === 'famille-mois' ? ', sans engagement' : ', renouvelée chaque année'}</li>`).join('')
      : '<li>Aucune formule pour le moment</li>';

    $('me-etagere').innerHTML = d.bibliotheque.map((h, i) =>
      `<li><button type="button" class="me-livre${h.a_venir ? ' me-a-venir' : ''}" data-i="${i}"${h.a_venir ? ' disabled' : ''}><strong>${texte(h.titre)}</strong>${h.theme ? `<span>${texte(h.theme)}</span>` : ''}<span class="me-lien">${h.a_venir ? `Sortie le ${date(h.date_sortie)}` : 'Ouvrir →'}</span></button></li>`).join('');
    $('me-etagere').querySelectorAll<HTMLButtonElement>('.me-livre:not([disabled])').forEach((b) => (b.onclick = () => ouvrirHistoire(d.bibliotheque[Number(b.dataset.i)])));
    let dec: string | null = null;
    try { dec = localStorage.getItem('clemi-decor'); if (dec === 'foret' || dec === 'mer') dec = null; } catch {}
    montrer(dec ? 'biblio' : 'decors');
  }

  document.querySelectorAll<HTMLButtonElement>('.me-onglets button').forEach((b) => (b.onclick = () => montrer(b.dataset.vue!)));
  document.querySelector<HTMLButtonElement>('[data-retour]')!.onclick = () => { $('me-histoire').hidden = true; $('me-etagere').hidden = false; };
  $('me-deconnexion').onclick = async () => { await sb?.auth.signOut(); location.replace(connexion); };
  document.querySelectorAll<HTMLButtonElement>('[data-decor]').forEach((b) => (b.onclick = () => {
    const d = b.dataset.decor!;
    document.documentElement.className = document.documentElement.className.replace(/\bdecor-\S+/g, '').trim();
    document.documentElement.classList.add(`decor-${d}`);
    try { localStorage.setItem('clemi-decor', d); } catch {}
    montrer('biblio');
  }));
  demarrer();
</script>

<style>
  :global(body) { background: transparent; min-height: 100vh; }
  .me-barre { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 10px 20px; background: rgba(251, 243, 227, 0.82); backdrop-filter: blur(8px); }
  .me-logo { text-decoration: none; }
  .me-onglets:not([hidden]) { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 auto; }
  .me-onglets button, :global(.me-ages button) { font: 800 0.92rem var(--f-label); border: 0; border-radius: 24px; padding: 9px 16px; background: #fff; color: var(--encre); box-shadow: 0 4px 0 var(--beige); cursor: pointer; transition: transform 0.12s; }
  .me-onglets button:hover, :global(.me-ages button:hover) { transform: translateY(-3px); }
  .me-onglets button[aria-selected='true'], :global(.me-ages button[aria-pressed='true']) { background: var(--sapin); color: #fff; box-shadow: 0 4px 0 var(--soleil); }
  .me-retour-site { font-weight: 800; color: var(--encre); }
  .me-scene { max-width: 1080px; margin: 0 auto; padding: 24px 16px 160px; }
  .me-tete { text-align: center; padding: 20px 0 10px; }
  .me-sur { font: 800 0.8rem var(--f-label); letter-spacing: 0.22em; text-transform: uppercase; color: var(--sapin); margin: 0; }
  .me-tete h1 { font-size: clamp(2.2rem, 6vw, 3.8rem); margin: 0.1em 0; text-shadow: 0 2px 0 rgba(255, 255, 255, 0.6); }
  .me-samedi { display: inline-flex; align-items: center; gap: 12px; background: #fff; border-radius: 999px; padding: 6px 18px 6px 6px; font-weight: 700; box-shadow: 0 5px 0 var(--beige); animation: me-flotte 5s ease-in-out infinite; }
  .me-samedi b { background: var(--sapin); color: #fff; border-radius: 999px; padding: 8px 16px; font-family: var(--f-titre); }
  .vue, .me-etat { background: rgba(251, 243, 227, 0.9); backdrop-filter: blur(3px); border-radius: 28px; padding: 26px; margin-top: 26px; box-shadow: 0 10px 30px rgba(36, 59, 50, 0.12); }
  .vue h2 { margin-top: 0; }
  .me-note { background: var(--soleil-doux); padding: 12px 16px; font-weight: 600; border-radius: 16px; }
  /* Portes des décors */
  .me-portes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; }
  .me-portes li { animation: me-entre 0.7s cubic-bezier(0.3, 1.5, 0.5, 1) both calc(var(--i) * 0.07s); }
  @keyframes me-entre { from { opacity: 0; transform: translateY(40px) scale(0.9); } }
  .me-porte { all: unset; cursor: pointer; display: block; width: 100%; border-radius: 26px; overflow: hidden; background: #fff; box-shadow: 0 8px 0 var(--beige); transition: transform 0.18s, box-shadow 0.18s; }
  .me-porte:hover, .me-porte:focus-visible { transform: translateY(-8px) rotate(-1deg); box-shadow: 0 16px 0 var(--beige); }
  .me-porte b { display: block; padding: 12px 14px; font: 700 1.1rem var(--f-titre); color: var(--encre); }
  .me-porte-vue { display: block; height: 130px; background: #2a3a30 center / cover no-repeat; }
  /* Les histoires, qui prennent la forme du décor */
  .me-etagere { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 26px; }
  :global(.me-livre) { position: relative; width: 100%; min-height: 220px; text-align: left; border: 0; border-radius: 4px 14px 14px 4px; padding: 20px 18px; display: grid; align-content: end; gap: 6px; font: inherit; color: #fff; cursor: pointer; background: linear-gradient(160deg, #3f8266, #2D6A4F); box-shadow: inset 12px 0 0 rgba(0, 0, 0, 0.2), 0 12px 22px rgba(36, 59, 50, 0.25); transition: transform 0.18s; }
  :global(.me-etagere li:nth-child(4n + 2) .me-livre) { background: linear-gradient(160deg, #f7d873, #e0ae1c); color: var(--encre); }
  :global(.me-etagere li:nth-child(4n + 3) .me-livre) { background: linear-gradient(160deg, #f3b98f, #d9784a); color: var(--encre); }
  :global(.me-etagere li:nth-child(4n) .me-livre) { background: linear-gradient(160deg, #a9d0bd, #6fa58a); color: var(--encre); }
  :global(.me-livre:hover) { transform: translateY(-10px) rotate(-2deg); }
  :global(.me-livre strong) { font-family: var(--f-titre); font-size: 1.2rem; line-height: 1.2; }
  :global(.me-a-venir) { opacity: 0.6; cursor: default; }
  :global(.me-lien) { font-weight: 800; }
  :global(html.decor-ciel .me-livre), :global(html.decor-jardin .me-livre) { border-radius: 999px; aspect-ratio: 1; min-height: 0; text-align: center; align-content: center; padding: 30px; }
  :global(html.decor-mer .me-livre) { border-radius: 50%; box-shadow: inset 0 0 0 6px rgba(255, 255, 255, 0.7), 0 0 30px rgba(255, 255, 255, 0.4); animation: me-flotte 5s ease-in-out infinite; }
  :global(html.decor-feu .me-livre) { box-shadow: 0 0 40px 8px #f4c43066, 0 12px 22px rgba(0, 0, 0, 0.4); }
  :global(html.decor-feu .vue), :global(html.decor-mer .vue) { background: rgba(251, 243, 227, 0.94); }
  :global(html.decor-foret .me-livre), :global(html.decor-cabane .me-livre), :global(html.decor-refuge .me-livre) { outline: 7px solid #8a5d36; }
  .me-ages { display: flex; gap: 8px; margin: 12px 0 20px; }
  .me-liste { padding-left: 1.2em; }
  :global(#me-h-activites), :global(#me-h-bonus) { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; }
  :global(#me-h-activites li), :global(#me-h-bonus li) { background: #fff; border-radius: 20px; padding: 14px 16px; box-shadow: 0 4px 0 var(--beige); font-weight: 700; }
  .me-bloc { margin-bottom: 24px; background: #fff; border-radius: 20px; padding: 16px 18px; }
  /* petite enceinte en bois : on appuie, elle vibre et l'histoire se lit */
  .me-enceinte { position: relative; width: 120px; height: 150px; border: 0; cursor: pointer; border-radius: 16px 16px 12px 12px; background: repeating-linear-gradient(95deg, #c99a62 0 9px, #b8864f 9px 11px, #d1a46d 11px 19px); box-shadow: inset 0 0 0 4px #8a5f33, 0 10px 18px rgba(36, 59, 50, 0.25); display: grid; place-items: center; transition: transform 0.15s; }
  .me-enceinte:hover { transform: rotate(-3deg) scale(1.04); }
  .me-hp { width: 76px; height: 76px; border-radius: 50%; background: radial-gradient(circle, #5a4636 0 18%, #2f2620 19% 58%, #4b3a2d 60% 100%); box-shadow: inset 0 0 0 5px #6e5440; display: grid; place-items: center; }
  .me-hp-play { position: absolute; width: 0; height: 0; border-left: 20px solid var(--soleil); border-top: 12px solid transparent; border-bottom: 12px solid transparent; margin-left: 6px; }
  #me-h-audio.joue .me-hp-play { border: 0; width: 18px; height: 22px; margin: 0; background: linear-gradient(90deg, var(--soleil) 0 35%, transparent 35% 65%, var(--soleil) 65%); }
  #me-h-audio.joue .me-hp { animation: me-boum 0.45s ease-in-out infinite; }
  .me-ondes { position: absolute; left: 100%; top: 50%; translate: 6px -50%; display: flex; gap: 5px; opacity: 0; transition: opacity 0.3s; }
  .me-ondes i { width: 10px; height: 30px; border: 3px solid var(--soleil); border-left: 0; border-radius: 0 50% 50% 0; animation: me-onde 1.2s ease-out infinite; }
  .me-ondes i:nth-child(2) { height: 44px; animation-delay: 0.2s; } .me-ondes i:nth-child(3) { height: 58px; animation-delay: 0.4s; }
  #me-h-audio.joue .me-ondes { opacity: 1; }
  @keyframes me-boum { 50% { transform: scale(1.08); } }
  @keyframes me-onde { from { opacity: 1; } to { opacity: 0.1; } }
  .me-video { position: relative; aspect-ratio: 16 / 9; max-width: 720px; }
  .me-video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 16px; }
  @keyframes me-flotte { 50% { translate: 0 -6px; } }
  @media (prefers-reduced-motion: reduce) { .me-scene *, :global(.me-livre) { animation: none !important; } }
</style>
