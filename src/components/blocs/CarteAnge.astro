---
/** Ange en exemple, sur fond de photo du loup. */
import { Image } from 'astro:assets';
import CouvertureAnge from '../CouvertureAnge.astro';
import Crete from '../Crete.astro';
import { photo } from '../../lib/photos';
interface Props { surtitre?: string; texte: string; bouton?: string; href: string }
const { surtitre = 'Un exemple, offert', texte, bouton = 'Découvrir la séance complète', href } = Astro.props;
---
<section class="bandeau-section ange-bloc">
  <Crete couleur="#1c3a2d" forme={3} />
  <Image class="ange-fond" src={photo('loup')} alt="" widths={[800, 1400]} sizes="100vw" loading="lazy" />
  <div class="conteneur ange-grille">
    <div class="ange-texte">
      <p class="surtitre-main">{surtitre}</p>
      <h2>Ange, le loup qui chantait avec le vent</h2>
      <p class="ange-themes"><span>Appartenance</span><span>Différence</span><span>Courage d’être soi</span></p>
      <p>{texte}</p>
      <a class="btn btn-soleil" href={href}>{bouton} →</a>
    </div>
    <div class="ange-couv"><CouvertureAnge /></div>
  </div>
</section>
<style>
  .ange-bloc { background: #1c3a2d; color: var(--creme); padding-block: clamp(72px, 9vw, 120px); }
  .ange-bloc :global(.ange-fond) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 22%; z-index: -1; }
  .ange-bloc::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(28, 58, 45, 0.97) 0%, rgba(28, 58, 45, 0.88) 50%, rgba(28, 58, 45, 0.4) 100%); }
  .ange-grille { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .ange-texte { display: grid; gap: 16px; justify-items: start; }
  .ange-texte h2 { color: #fff; }
  .ange-texte .surtitre-main { color: var(--soleil); }
  .ange-texte > p:not(.surtitre-main) { color: var(--menthe); max-width: 36em; }
  .ange-themes { display: flex; flex-wrap: wrap; gap: 10px; }
  .ange-themes span { font: 700 0.85rem var(--f-label); padding: 4px 12px; border: 2px solid var(--soleil-doux); color: var(--soleil-doux); transform: rotate(-1deg); }
  .ange-couv { max-width: 300px; justify-self: center; transform: rotate(4deg); filter: drop-shadow(10px 10px 0 rgba(0, 0, 0, 0.35)); }
  @media (max-width: 860px) { .ange-grille { grid-template-columns: 1fr; } .ange-couv { max-width: 220px; } .ange-bloc::before { background: rgba(28, 58, 45, 0.9); } }
</style>
