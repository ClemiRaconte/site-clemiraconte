---
/** Haut de page intérieure : texte à gauche, photo encadrée à droite, bulles en fond. */
import { Image } from 'astro:assets';
import Bulles from '../Bulles.astro';
import { photo as getPhoto } from '../../lib/photos';
interface Props { surtitre: string; titre: string; intro?: string; photo?: string; alt?: string; legende?: string }
const { surtitre, titre, intro, photo, alt = '', legende } = Astro.props;
---
<section class="bandeau-section fond-creme page-tete">
  <Bulles nombre={14} graine={titre.length} />
  <div class:list={['conteneur', 'pt-grille', { 'sans-photo': !photo }]}>
    <div class="pt-texte">
      <p class="surtitre-main">{surtitre}</p>
      <h1>{titre}</h1>
      {intro && <p class="pt-intro">{intro}</p>}
      <div class="pt-actions"><slot /></div>
    </div>
    {photo && (
      <figure class="pt-photo">
        <Image src={getPhoto(photo)} alt={alt} widths={[500, 800, 1100]} sizes="(min-width: 900px) 480px, 90vw" loading="eager" />
        {legende && <figcaption class="main">{legende}</figcaption>}
        <span class="scotch" aria-hidden="true"></span>
      </figure>
    )}
  </div>
</section>
<style>
  .page-tete { padding-block: clamp(40px, 6vw, 80px) clamp(88px, 10vw, 130px); }
  .pt-grille { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .pt-grille.sans-photo { grid-template-columns: 1fr; max-width: 820px; }
  .pt-texte { display: grid; gap: 20px; justify-items: start; }
  .pt-texte h1 { font-size: clamp(2.1rem, 4.6vw, 3.5rem); text-wrap: balance; }
  .pt-intro { font-size: 1.15rem; color: var(--gris); max-width: 36em; }
  .pt-actions { display: flex; flex-wrap: wrap; gap: 14px 18px; }
  .pt-actions:empty { display: none; }
  .pt-photo { margin: 0; position: relative; background: #fff; padding: 12px 12px 0; border: 3px solid var(--encre); box-shadow: 10px 10px 0 var(--sapin); transform: rotate(2deg); }
  .pt-photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .pt-photo figcaption { text-align: center; padding: 8px 4px 12px; font-size: 1.5rem; color: var(--encre); }
  .pt-photo:not(:has(figcaption)) { padding-bottom: 12px; }
  .scotch { position: absolute; top: -14px; left: 24px; width: 100px; height: 28px; background: rgba(247, 216, 115, 0.85); transform: rotate(-7deg); }
  @media (max-width: 860px) {
    .pt-grille { grid-template-columns: 1fr; }
    .pt-photo { max-width: 460px; transform: rotate(1.5deg); }
  }
</style>
