---
/** Étiquettes en petits nuages cotonneux. Les thèmes connus ont leur décor (le nuage qui pleure pour les émotions, etc.). */
interface Props { items: string[]; centre?: boolean }
const { items, centre = false } = Astro.props;
const decor = (t: string) => {
  const m = t.toLowerCase();
  if (m.includes('émotion')) return 'pleure';
  if (m.includes('harcèlement')) return 'parapluie';
  if (m.includes('consentement')) return 'coeur';
  if (m.includes('stéréotype')) return 'moitie';
  if (m.includes('différence')) return 'diff';
  if (m.includes('écran')) return 'ecran';
  if (m.includes('famille')) return 'famille';
  return '';
};
// Nuages dessinés (Gemini, 25/11) : public/nuages/<cle>.webp. x, y = centre du titre en %, r = hauteur / largeur.
const DESSINS: Record<string, { r: number; x: number; y: number }> = {"stereotypes": {"r": 0.578, "x": 50.0, "y": 69.5}, "consentement": {"r": 0.5, "x": 58, "y": 60.3}, "harcelement": {"r": 0.792, "x": 50.0, "y": 80}, "apprendre": {"r": 0.595, "x": 52.0, "y": 66.7}, "separation": {"r": 0.378, "x": 49.8, "y": 63.1}, "familles": {"r": 0.505, "x": 43.1, "y": 61.0}, "groupe": {"r": 0.556, "x": 48.7, "y": 64.5}, "emotions": {"r": 0.599, "x": 50.0, "y": 56.9}, "difference": {"r": 0.573, "x": 50.1, "y": 65.8}, "grandir": {"r": 0.638, "x": 50.0, "y": 77.1}, "ecrans": {"r": 0.613, "x": 49.9, "y": 70.1}, "handicap": {"r": 0.624, "x": 49.9, "y": 47.9}};
const dessin = (t: string) => {
  const m = t.toLowerCase();
  const cle = m.includes('consentement') ? 'consentement' : m.includes('harcèlement') ? 'harcelement' : m.includes('apprendre') ? 'apprendre'
    : m.includes('séparation') ? 'separation' : m.includes('famille') ? 'familles' : m.includes('groupe') ? 'groupe' : m.includes('émotion') ? 'emotions'
    : m.includes('différence') ? 'difference' : m.includes('grandir') ? 'grandir' : m.includes('écran') ? 'ecrans' : m.includes('handicap') ? 'handicap' : m.includes('stéréotype') ? 'stereotypes' : '';
  return cle ? { cle, ...DESSINS[cle] } : null;
};
---
<ul class:list={['etiquettes', { centre }]}>
  {items.map((t, i) => {
    const g = dessin(t);
    if (g) return (
      <li class="dessin" style={`--i:${i};--r:${g.r}`}>
        <span class="dessin-corps">
          <img src={`/nuages/${g.cle}.webp`} alt="" loading="lazy" decoding="async" />
          <b style={`left:${g.x}%;top:${g.y}%`}>{t}</b>
        </span>
      </li>
    );
    const d = decor(t);
    return (
      <li class:list={['nuage', d && `n-${d}`]} style={`--i:${i}`}>
        <span class="corps">
          <i class="p p1"></i><i class="p p2"></i><i class="p p3"></i>
          {d === 'coeur' && <i class="deco coeur">&#9829;</i>}
          {d === 'moitie' && <i class="deco question">?</i>}
          {d === 'parapluie' && <svg class="deco para" viewBox="0 0 40 40" aria-hidden="true"><path d="M2 20a18 18 0 0136 0z" fill="#2D6A4F" /><path d="M20 20v14a3 3 0 01-6 0" stroke="#243b32" stroke-width="2.5" fill="none" /></svg>}
          {d === 'ecran' && <svg class="deco ecran" viewBox="0 0 40 30" aria-hidden="true"><rect x="3" y="3" width="34" height="20" rx="3" fill="#243b32" /><text x="20" y="17" font-size="9" text-anchor="middle" fill="#F4C430" font-family="sans-serif">zZ</text><rect x="15" y="24" width="10" height="3" fill="#243b32" /></svg>}
          {d === 'pleure' && <><i class="larme"></i><i class="larme l2"></i><i class="larme l3"></i></>}
          {d === 'famille' && <><i class="bebe b1"></i><i class="bebe b2"></i></>}
          <b>{t}</b>
        </span>
      </li>
    );
  })}
</ul>
<style>
  .etiquettes { list-style: none; margin: 0; padding: 46px 0 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 46px 30px; }
  .etiquettes.centre { justify-content: center; }
  .nuage { position: relative; animation: apparait 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) both calc(var(--i) * 0.08s); }
  @keyframes apparait { from { opacity: 0; transform: translateY(30px) scale(0.7); } }
  .corps { position: relative; display: block; padding: 16px 28px; border-radius: 999px; background: radial-gradient(circle at 40% 30%, #fff 0, #fffaf0 45%, #f3e8d2 100%); box-shadow: inset 0 -8px 14px rgba(200, 180, 140, 0.35), 0 10px 20px rgba(36, 59, 50, 0.12); transition: transform 0.12s ease-out; animation: derive 7s ease-in-out infinite calc(var(--i) * -1.1s); }
  @keyframes derive { 33% { translate: 6px -8px; } 66% { translate: -6px -3px; } }
  .corps::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: inherit; z-index: 2; }
  .corps b { position: relative; z-index: 3; font: 800 1rem var(--f-label); color: var(--encre); white-space: nowrap; }
  .p { position: absolute; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #fff 0, #fffaf0 55%, #f3e8d2 100%); z-index: 1; }
  .p1 { width: 50px; height: 50px; top: -24px; left: 16%; } .p2 { width: 66px; height: 66px; top: -36px; left: 42%; } .p3 { width: 42px; height: 42px; top: -16px; right: 10%; }
  .nuage:hover .corps { transform: scale(1.1) rotate(-2deg); animation-play-state: paused; }
  .deco { position: absolute; z-index: 4; font-style: normal; }
  .coeur { top: -44px; left: 46%; color: #e07a6b; font-size: 1.5rem; transition: transform 0.12s; } .n-coeur:hover .coeur { transform: scale(1.5); }
  .question { top: -40px; right: -4px; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--soleil); color: var(--encre); font: 800 0.95rem var(--f-label); }
  .n-moitie .p1 { background: radial-gradient(circle at 40% 35%, #f2f8ee, #cfe3c6); } .n-moitie .p3 { background: radial-gradient(circle at 40% 35%, #fff8dc, #f7dc84); }
  .para { width: 50px; top: -62px; left: 38%; transition: transform 0.15s; } .n-parapluie:hover .para { transform: translateY(10px) rotate(-8deg); }
  .n-diff .p2 { background: radial-gradient(circle at 40% 35%, #fff3c4, #F4C430); transition: transform 0.12s; } .n-diff:hover .p2 { transform: translateY(-6px) scale(1.15); }
  .ecran { width: 38px; top: -44px; right: 12%; }
  .larme { position: absolute; bottom: -6px; left: 35%; width: 9px; height: 13px; background: #9fcbe0; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; animation: pleure 1.6s ease-in infinite; }
  .l2 { left: 55%; animation-delay: 0.5s; } .l3 { left: 70%; animation-delay: 1s; } .n-pleure:hover .larme { animation-duration: 0.7s; }
  @keyframes pleure { 0% { transform: translateY(0); opacity: 0; } 20% { opacity: 1; } 100% { transform: translateY(34px); opacity: 0; } }
  .bebe { position: absolute; border-radius: 999px; background: radial-gradient(circle at 40% 30%, #fff, #f3e8d2); box-shadow: 0 4px 8px rgba(36, 59, 50, 0.1); animation: suit 3s ease-in-out infinite; transition: translate 0.15s; }
  .b1 { width: 42px; height: 24px; right: -34px; bottom: -12px; } .b2 { width: 28px; height: 17px; right: -60px; bottom: -2px; animation-delay: 0.4s; }
  @keyframes suit { 50% { transform: translateY(-6px); } } .n-famille:hover .bebe { translate: -8px -4px; }
  /* nuages dessinés : ils flottent doucement, et au survol ils se gonflent et se penchent */
  .dessin { position: relative; animation: apparait 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) both calc(var(--i) * 0.08s); }
  .dessin-corps {
    position: relative; display: block; container-type: inline-size; width: calc(185px / sqrt(var(--r)));
    max-width: 78vw; aspect-ratio: 1 / var(--r); animation: derive 7s ease-in-out infinite calc(var(--i) * -1.1s);
    transition: transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1); filter: drop-shadow(0 10px 12px rgba(36, 59, 50, 0.12));
  }
  .dessin-corps img { width: 100%; height: 100%; display: block; }
  .dessin-corps b {
    position: absolute; translate: -50% -50%; width: 70%; text-align: center; font: 800 clamp(0.78rem, 7cqw, 1rem) / 1.15 var(--f-label); color: var(--encre);
  }
  .dessin:hover .dessin-corps { transform: scale(1.08) rotate(-2deg); animation-play-state: paused; }
  .dessin:hover img { animation: rebond 0.9s ease-in-out infinite; }
  @keyframes rebond { 50% { transform: translateY(-4px) scaleY(1.02); } }
  @media (prefers-reduced-motion: reduce) { .nuage, .corps, .larme, .bebe, .dessin, .dessin-corps, .dessin img { animation: none; } }
</style>
