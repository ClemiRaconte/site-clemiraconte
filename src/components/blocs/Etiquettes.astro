---
/** Étiquettes de thèmes. Les 12 grands thèmes ont leur scène dessinée (Gemini, 25/11) qui s'anime au survol ou au toucher.
 * Les autres mots restent des étiquettes simples. `simple` = jamais de scène (en-tête d'une histoire, par exemple). */
import SCENES from '../../data/scenes-themes.json';
interface Props { items: string[]; centre?: boolean; simple?: boolean }
const { items, centre = false, simple = false } = Astro.props;
const cle = (t: string) => {
  const m = t.toLowerCase();
  return m.includes('consentement') ? 'consentement' : m.includes('harcèlement') ? 'harcelement' : m.includes('apprendre') ? 'apprendre'
    : m.includes('séparation') ? 'separation' : m.includes('famille') ? 'familles' : m.includes('groupe') ? 'groupe' : m.includes('émotion') ? 'emotions'
    : m.includes('différence') ? 'difference' : m.includes('grandir') ? 'grandir' : m.includes('écran') ? 'ecrans' : m.includes('handicap') ? 'handicap' : m.includes('stéréotype') ? 'stereotypes' : '';
};
---
<ul class:list={['etiquettes', { centre }]}>
  {items.map((t, i) => {
    const k = simple ? '' : cle(t);
    if (k) return (
      <li class="ta" tabindex="0" style={`--i:${i}`}>
        <div class="ta-scene" set:html={(SCENES as Record<string, string>)[k]} />
        <b>{t}</b>
      </li>
    );
    return <li class="etiquette" style={`--i:${i}`}>{t}</li>;
  })}
</ul>
<script>
  document.querySelectorAll<HTMLElement>('.ta').forEach((el) => {
    el.addEventListener('click', () => el.classList.toggle('on'));
  });
</script>
<style>
  .etiquettes { list-style: none; margin: 0; padding: 10px 0 20px; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 22px 26px; }
  .etiquettes.centre { justify-content: center; }
  .etiquette { background: var(--creme-carte); color: var(--encre); font: 800 0.95rem var(--f-label); padding: 8px 16px; border-radius: 18px 14px 20px 12px; box-shadow: 0 6px 14px rgba(36, 59, 50, 0.1); transform: rotate(-1.5deg); }
  .etiquette:nth-child(2n) { transform: rotate(1.5deg); background: var(--soleil-doux); }
  .ta { width: min(230px, 42vw); text-align: center; cursor: pointer; outline: none; animation: ta-apparait 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) both calc(var(--i) * 0.08s); }
  .ta b { display: block; margin-top: 4px; font: 800 1rem/1.2 var(--f-label); color: var(--encre); }
  :global(.fond-sapin) .ta b { color: inherit; }
  .ta-scene { position: relative; aspect-ratio: 1; overflow: hidden; }
  @keyframes ta-apparait { from { opacity: 0; transform: translateY(30px) scale(0.8); } }
</style>
<style is:global>

.ta .p{position:absolute;height:auto;transition:opacity .45s var(--d),transform .6s cubic-bezier(.3,1.6,.5,1) var(--d)}
.ta .grp{position:absolute;inset:0;transition:transform 2.2s ease-in-out;animation:ta-bob 4s ease-in-out infinite}
.ta:hover .grp,.ta.on .grp,.ta:focus-within .grp{transform:translateY(-42%);transition:transform 3.5s ease-in-out 1.6s}
.ta .mh{opacity:0;transform:scale(.4) translateY(20%)}
.ta:hover .mh,.ta.on .mh,.ta:focus-within .mh{opacity:1;transform:none}
.ta:hover .mx,.ta.on .mx,.ta:focus-within .mx{opacity:0;transform:scale(.8)}
/* idle anims (always) */
.ta .drift{animation:ta-drift 9s ease-in-out infinite alternate}.ta .drift2{animation:ta-drift 11s ease-in-out infinite alternate-reverse}
@keyframes ta-drift{to{translate:18% 0}}
@keyframes ta-bob{50%{translate:0 -3%}}
.ta .swing{transform-origin:50% 0;animation:ta-swing 3s ease-in-out infinite}@keyframes ta-swing{50%{rotate:3deg}}
.ta .sway{transform-origin:50% 0;animation:ta-swing 4s ease-in-out infinite}
.ta .kite{animation:ta-kite 5s ease-in-out infinite}@keyframes ta-kite{50%{translate:6% -8%;rotate:-8deg}}
.ta .wiggle{animation:ta-wig 2.5s ease-in-out infinite}@keyframes ta-wig{50%{rotate:-10deg}}
.ta .wave{transform-origin:0 100%;animation:ta-wig 1.6s ease-in-out infinite}
.ta .crawl{animation:ta-crawl 14s linear infinite alternate}@keyframes ta-crawl{to{translate:60% 0}}
.ta .peek{animation:ta-peek 3.4s ease-in-out infinite}@keyframes ta-peek{50%{translate:0 -10%}}
.ta .glow{animation:ta-glow 2s ease-in-out infinite}@keyframes ta-glow{50%{filter:brightness(1.25)}}
.ta .rain{animation:ta-rain 1.1s linear infinite;animation-delay:var(--d)}@keyframes ta-rain{from{translate:0 -40%;opacity:0}30%{opacity:1}to{translate:0 160%;opacity:0}}
.ta .wobble{animation:ta-wig 1.2s ease-in-out infinite}
.ta .lid{transform-origin:50% 100%;transition:transform .7s cubic-bezier(.3,1.5,.5,1)}
.ta:hover .lid,.ta.on .lid,.ta:focus-within .lid{transform:translate(-62%,-38%) rotate(-28deg)}
.ta .shake{transition:none}.ta:hover .shake,.ta.on .shake{animation:ta-shake .5s 2}@keyframes ta-shake{25%{rotate:-6deg}75%{rotate:6deg}}
.ta .hop{animation:ta-hop 2.6s ease-in-out infinite;animation-delay:var(--d)}@keyframes ta-hop{0%,70%,100%{translate:0}80%{translate:0 -16%}}
.ta:hover .hop,.ta.on .hop{animation-duration:.6s}
.ta .dance{animation:ta-dance 1.4s ease-in-out infinite}@keyframes ta-dance{25%{rotate:-12deg;translate:0 -10%}75%{rotate:12deg}}
/* hover anims (ta-run once visible) */
.ta:hover .flick,.ta.on .flick{animation:ta-flick .25s ease-in-out infinite alternate}@keyframes ta-flick{to{scale:1.08 1.22}}
.ta .flick{transform-origin:50% 100%}
.ta .pour{scale:-1 1}.ta:hover .pour,.ta.on .pour{rotate:-22deg;transition:rotate .5s}
.ta .growA{transform-origin:50% 100%}.ta:hover .growA,.ta.on .growA{animation:ta-hideL .1s 3s forwards}@keyframes ta-hideL{to{opacity:0}}
.ta .growB{transform-origin:50% 100%;transform:scale(.2)}
.ta:hover .run,.ta.on .run{animation:ta-run 3s linear infinite}@keyframes ta-run{from{translate:-40% 0}to{translate:280% 0}}
.ta:hover .flutter,.ta.on .flutter{animation:ta-flut .3s infinite alternate,ta-kite 3s infinite}@keyframes ta-flut{to{scale:.6 1}}
.ta:hover .rise,.ta.on .rise{animation:ta-rise 2.4s ease-out infinite}@keyframes ta-rise{from{translate:0 20%}to{translate:0 -40%;opacity:0}}
.ta:hover .spin,.ta.on .spin{animation:ta-spin 12s linear infinite}@keyframes ta-spin{to{rotate:360deg}}
.ta .open{transform-origin:50% 100%}
.ta:hover .popU,.ta.on .popU{animation:ta-hop 1.2s ease-in-out infinite;animation-delay:calc(var(--d) + .6s)}
.ta:hover .fly,.ta.on .fly{animation:ta-fly 3.2s ease-in-out infinite;animation-delay:var(--d)}@keyframes ta-fly{from{translate:-120% 30%;rotate:10deg}to{translate:420% -40%;rotate:-14deg}}
.ta:hover .roll,.ta.on .roll{animation:ta-roll 3s ease-out forwards}@keyframes ta-roll{from{translate:-100% 0}to{translate:80% -6%}}
.ta:hover .smoke,.ta.on .smoke{animation:ta-rise 3s ease-out infinite}
.ta:hover .walk,.ta.on .walk{animation:ta-walk 3.5s ease-in-out forwards;animation-delay:var(--d)}@keyframes ta-walk{from{translate:0 0}50%{translate:300% -40%}to{translate:530% 0}}
.ta:hover .fall,.ta.on .fall{animation:ta-fall 3s ease-in-out infinite}@keyframes ta-fall{to{translate:40% 300%;rotate:80deg;opacity:0}}
.ta .snap{transition-duration:.5s,.9s}.mh.snap{transform:translate(120%,60%) rotate(30deg)}
.ta:hover .twinkle,.ta.on .twinkle{animation:ta-tw 1s ease-in-out infinite alternate}@keyframes ta-tw{to{scale:.6;rotate:30deg}}
.ta:hover .blink,.ta.on .blink{animation:ta-hideL .1s .8s forwards}
.ta:hover .snow,.ta.on .snow{animation:ta-snow 2.5s linear infinite}@keyframes ta-snow{from{translate:0 -10%}to{translate:0 15%}}
.ta:hover .jump,.ta.on .jump{animation:ta-jump 1.6s ease-in-out infinite;animation-delay:calc(var(--d) + .6s)}@keyframes ta-jump{50%{translate:0 -18%;rotate:6deg}}
.mh.jump{transform:translateY(40%) scale(.3)}
.ta:hover .float,.ta.on .float{animation:ta-float 4s ease-in infinite;animation-delay:1.5s}@keyframes ta-float{to{translate:10% -260%}}
.ta:hover .burst,.ta.on .burst{animation:ta-burst 1.4s ease-out}@keyframes ta-burst{from{scale:.2}}
@media (prefers-reduced-motion:reduce){.ta *{animation:none!important;transition-duration:.01s!important}}

.mh.land{transform:translate(380%,-260%) rotate(-20deg)}
.ta:hover .land,.ta.on .land,.ta:focus-within .land{transition:opacity .2s, transform 1.4s ease-out}
.mh.water{transform:none}.ta:hover .water,.ta.on .water{animation:ta-rain .8s linear infinite;animation-delay:var(--d)}
.ta:hover .mx[style*="--d:1.6s"],.ta.on .mx[style*="--d:1.6s"]{transition-delay:1.6s}
.mh.snap{transform:translate(150%,-60%) rotate(35deg)}.ta:hover .snap,.ta.on .snap{transition:opacity .3s,transform 1s cubic-bezier(.3,1.2,.5,1)}
.ta:hover .blink,.ta.on .blink{animation:ta-hideL .1s 2.4s forwards}
.ta .lid{transform-origin:50% 100%}
.ta .lid{z-index:3;transform-origin:50% 100%!important;transform:scaleY(.36);transition:transform .5s ease-in,z-index 0s .25s}
.ta .box{z-index:2}[class*=out]{z-index:1}
.ta:hover .lid,.ta.on .lid,.ta:focus-within .lid{z-index:0;transform:translateY(-18%) rotate(-7deg);transition:transform .7s cubic-bezier(.3,1.5,.5,1),z-index 0s .2s}
.ta:hover .box,.ta.on .box{animation:ta-shake .35s 2}
.mh[class*=out]{transform:translateY(25%) scale(.9);opacity:0}
.ta:hover [class*=out],.ta.on [class*=out]{transition:transform .7s cubic-bezier(.3,1.8,.5,1) var(--d)}
.ta:hover .outA,.ta.on .outA{transform:translate(-10%,-95%) rotate(-12deg)}
.ta:hover .outB,.ta.on .outB{transform:translate(-20%,-120%) rotate(-20deg)}
.ta:hover .outC,.ta.on .outC{transform:translate(0,-130%)}
.ta:hover .outD,.ta.on .outD{transform:translate(10%,-110%) rotate(10deg)}
.ta:hover .outE,.ta.on .outE{transform:translate(25%,-120%) rotate(18deg)}

</style>
