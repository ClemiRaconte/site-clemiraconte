---
/** Étiquettes collées de travers : thèmes, repères, activités. */
interface Props { items: string[]; centre?: boolean }
const { items, centre = false } = Astro.props;
---
<ul class:list={['etiquettes', { centre }]}>
  {items.map((t) => <li>{t}</li>)}
</ul>
<style>
  .etiquettes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .etiquettes.centre { justify-content: center; }
  .etiquettes li { background: var(--creme-carte); color: var(--encre); font: 800 0.95rem var(--f-label); padding: 8px 14px; border: 2px solid var(--encre); box-shadow: 3px 3px 0 var(--sapin); transform: rotate(var(--r, -2deg)); transition: transform 0.2s; }
  .etiquettes li:nth-child(3n) { --r: 2.5deg; background: var(--soleil-doux); }
  .etiquettes li:nth-child(3n + 1) { --r: -1.5deg; }
  .etiquettes li:nth-child(4n) { --r: 1deg; background: var(--menthe); }
  .etiquettes li:hover { transform: rotate(0) scale(1.05); }
  :global(.fond-sapin) .etiquettes li { box-shadow: 3px 3px 0 var(--sapin-fonce); border-color: var(--sapin-fonce); }
</style>
