---
/**
 * Étagère de livres illustrés (couvertures Gemini, choix de Clément du 25/11).
 * Chaque thème a sa couverture (public/livres/livre-N.webp, N = numéro du thème dans l'année).
 * Le titre est écrit sur l'étiquette vierge du dessin (l = gauche, haut, largeur, hauteur en %).
 * Au survol (ou au toucher sur téléphone), la couverture s'ouvre comme une porte sur une page crème.
 */
interface Props { items: string[] }
const { items } = Astro.props;
const LIVRES: Record<string, { n: number; r: number; l: number[]; a: string }> = {"La différence": {"n": 1, "r": 1.299, "l": [28.5, 11.3, 47.8, 16.9], "a": "Et si ce qui nous rend différents était ce qui nous rapproche ?"}, "Les émotions": {"n": 2, "r": 1.342, "l": [22.5, 11.6, 55.7, 17.4], "a": "Colère, joie, peur : apprendre à les reconnaître et à les accueillir."}, "Trouver sa place dans le groupe": {"n": 3, "r": 1.339, "l": [22.7, 11.2, 58.2, 21.5], "a": "Chacun a sa pièce du puzzle, il suffit de la trouver."}, "Les nouvelles familles": {"n": 4, "r": 1.396, "l": [25.2, 11.6, 52.3, 18.7], "a": "Toutes les familles ne se ressemblent pas, et c'est très bien comme ça."}, "La séparation des parents": {"n": 5, "r": 1.359, "l": [30.2, 11.0, 47.4, 16.6], "a": "Deux maisons, un pont, et un enfant toujours aimé."}, "Le handicap, visible et invisible": {"n": 6, "r": 1.361, "l": [24.9, 8.3, 50.2, 15.5], "a": "Jouer ensemble, avec nos forces et nos différences."}, "Apprendre autrement": {"n": 7, "r": 1.35, "l": [28.3, 10.4, 50.2, 19.3], "a": "Chacun apprend à sa façon, et à son rythme."}, "Le harcèlement": {"n": 8, "r": 1.355, "l": [29.8, 10.8, 49.7, 17.7], "a": "Quand ça ne va pas, on n'est jamais seul sous la pluie."}, "Le consentement": {"n": 9, "r": 1.188, "l": [24.4, 12.1, 45.1, 17.0], "a": "Avant un câlin, on demande. Et on écoute la réponse."}, "Les écrans": {"n": 10, "r": 1.435, "l": [26.7, 9.8, 52.9, 14.0], "a": "Et si on sortait de l'écran pour aller jouer dehors ?"}, "Grandir, à son rythme": {"n": 11, "r": 1.476, "l": [32.0, 9.4, 48.6, 15.2], "a": "Personne ne pousse à la même vitesse, et c'est normal."}};
const taille = (t: string) => (t.length < 16 ? 7.4 : t.length < 24 ? 6.2 : 5.4);
const rangees: string[][] = [];
for (let i = 0; i < items.length; i += 4) rangees.push(items.slice(i, i + 4));
---
<div class="etagere">
  {rangees.map((rang) => (
    <ul class="rang" role="list">
      {rang.map((t) => {
        const b = LIVRES[t];
        if (!b) return null;
        return (
          <li>
            <button type="button" class="livre" style={`--r:${b.r}`} aria-label={`${t} : ${b.a}`}>
              <span class="page">
                <span class="num">n°{b.n}</span>
                <span class="nom">{t}</span>
                <span class="accroche">{b.a}</span>
                <span class="semaine">une histoire par semaine</span>
              </span>
              <span class="couv">
                <img src={`/livres/livre-${b.n}.webp`} alt="" loading="lazy" decoding="async" />
                <span class="titre" style={`left:${b.l[0]}%;top:${b.l[1]}%;width:${b.l[2]}%;height:${b.l[3]}%;font-size:${taille(t)}cqw`}>{t}</span>
              </span>
            </button>
          </li>
        );
      })}
    </ul>
  ))}
</div>

<script>
  // Sur écran tactile (pas de survol), un toucher ouvre le livre et referme les autres.
  document.querySelectorAll<HTMLButtonElement>('.etagere .livre').forEach((b) =>
    b.addEventListener('click', () => {
      if (!matchMedia('(hover: none)').matches) return;
      document.querySelectorAll('.etagere .livre.ouvert').forEach((o) => o !== b && o.classList.remove('ouvert'));
      b.classList.toggle('ouvert');
    })
  );
</script>

<style>
  .etagere { max-width: 900px; margin: 0 auto; padding: 10px 12px 20px; }
  .rang {
    list-style: none; margin: 0 0 58px; padding: 0 16px; position: relative;
    display: flex; justify-content: center; align-items: flex-end; gap: 22px;
  }
  .rang::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -16px; height: 18px; border-radius: 3px;
    background: linear-gradient(#9a6a46, #8a5a3b 55%, #6f4730); box-shadow: 0 10px 16px -6px rgba(0, 0, 0, 0.35);
  }
  .rang li { display: flex; }
  .livre {
    all: unset; cursor: pointer; position: relative; display: block; container-type: inline-size;
    width: min(170px, 21vw); aspect-ratio: 1 / var(--r); perspective: 1400px;
  }
  .couv, .page { position: absolute; inset: 0; border-radius: 4px 10px 10px 4px; }
  .page {
    background: var(--creme-carte, #fbf3e3); box-sizing: border-box; padding: 14% 12%;
    display: flex; flex-direction: column; gap: 6px; text-align: left; color: var(--encre);
    box-shadow: inset 6px 0 10px rgba(0, 0, 0, 0.12), 0 6px 14px rgba(0, 0, 0, 0.25);
  }
  .num { font: 700 1.1rem var(--f-main); color: var(--sapin); }
  .nom { font: 700 0.98rem / 1.15 var(--f-titre); }
  .accroche { font-size: 0.8rem; line-height: 1.35; }
  .semaine { margin-top: auto; font: 700 0.95rem var(--f-main); color: var(--sapin); }
  .couv {
    transform-origin: 6% 50%; backface-visibility: hidden; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.3));
    transition: transform 0.7s cubic-bezier(0.3, 0.7, 0.2, 1), filter 0.7s;
  }
  .couv img { width: 100%; height: 100%; display: block; }
  .titre {
    position: absolute; box-sizing: border-box; padding: 0 4%; display: flex; align-items: center; justify-content: center;
    text-align: center; font-family: var(--f-titre); font-weight: 700; line-height: 1.08; color: var(--encre);
  }
  .livre:hover .couv, .livre:focus-visible .couv, .livre.ouvert .couv {
    transform: rotateY(-118deg); filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.15)) brightness(0.85);
  }
  .livre:hover, .livre.ouvert { z-index: 2; }
  .livre:focus-visible { outline: 3px solid var(--soleil); outline-offset: 6px; }
  @media (max-width: 620px) {
    .rang { display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px 16px; padding: 0 8px; justify-items: center; }
    .rang::after { display: none; }
    .rang li { position: relative; }
    .rang li::after { content: ''; position: absolute; left: -10px; right: -10px; bottom: -14px; height: 12px; border-radius: 3px; background: linear-gradient(#9a6a46, #6f4730); }
    .livre { width: 38vw; }
    .accroche { font-size: 0.74rem; }
  }
  @media (prefers-reduced-motion: reduce) { .couv { transition: none; } }
</style>
