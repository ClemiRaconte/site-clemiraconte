---
/**
 * Bouton lune : tamise la lumière du site pour la soirée (ou la rallume).
 * Le mode est calculé dans le <head> (lib/saison.ts) et posé sur <html data-lumiere>.
 */
interface Props { clair?: boolean }
const { clair = false } = Astro.props;
---
<button type="button" class:list={['lune', { clair }]} data-lune aria-pressed="false" title="Lumière douce">
  <svg class="ic-lune" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15A8 8 0 0 1 9 4a8 8 0 1 0 11 11z" fill="currentColor" /></svg>
  <svg class="ic-soleil" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  <span class="visuellement-cache" data-lune-texte>Lumière douce</span>
</button>

<script>
  const maj = () => {
    const tamise = document.documentElement.dataset.lumiere && document.documentElement.dataset.lumiere !== 'jour';
    document.querySelectorAll<HTMLButtonElement>('[data-lune]').forEach((b) => {
      b.setAttribute('aria-pressed', String(Boolean(tamise)));
      const t = tamise ? 'Rallumer la lumière' : 'Lumière douce pour le soir';
      b.title = t;
      b.querySelector('[data-lune-texte]')!.textContent = t;
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-lune]').forEach((b) => (b.onclick = () => { (window as any).clemiLumiere?.(); maj(); }));
  document.addEventListener('clemi-lumiere', maj);
  maj();
</script>

<style>
  .lune { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--ligne); background: var(--creme-carte); color: var(--sapin); display: grid; place-items: center; cursor: pointer; transition: transform 0.15s, background 0.4s; }
  .lune:hover { transform: rotate(-12deg) scale(1.06); }
  .lune svg { width: 20px; height: 20px; grid-area: 1 / 1; transition: opacity 0.4s, transform 0.4s; }
  .ic-soleil { opacity: 0; transform: scale(0.6); }
  .lune[aria-pressed='true'] { background: #3b2e22; border-color: #3b2e22; color: var(--soleil-doux); }
  .lune[aria-pressed='true'] .ic-lune { opacity: 0; transform: scale(0.6); }
  .lune[aria-pressed='true'] .ic-soleil { opacity: 1; transform: none; }
  .lune.clair { background: rgba(255, 253, 247, 0.92); border-color: transparent; }
</style>
