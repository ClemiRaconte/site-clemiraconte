---
/** Piste 1 : Clémi la luciole conteuse. */
interface Props { taille?: number; class?: string }
const { taille = 56, class: cls } = Astro.props;
---
<svg class={cls} width={taille} height={taille} viewBox="0 0 64 64" role="img" aria-label="Clémi la luciole">
  <circle class="halo halo-1" cx="42" cy="45" r="19" fill="#F4C430" opacity=".18" />
  <circle class="halo halo-2" cx="42" cy="45" r="12.5" fill="#F4C430" opacity=".35" />
  <ellipse cx="40" cy="43" rx="11" ry="8.5" transform="rotate(32 40 43)" fill="#F4C430" />
  <path d="M35 37.5c3 1.6 5.6 4 7.2 7.2" stroke="#e0a91c" stroke-width="1.6" fill="none" stroke-linecap="round" />
  <ellipse cx="38" cy="25" rx="11" ry="6" transform="rotate(-28 38 25)" fill="var(--lc, #fffdf7)" stroke="var(--lv, #2D6A4F)" stroke-width="2" />
  <ellipse cx="43" cy="31" rx="10" ry="5.5" transform="rotate(4 43 31)" fill="var(--lc, #fffdf7)" stroke="var(--lv, #2D6A4F)" stroke-width="2" />
  <circle cx="26" cy="35" r="13" fill="var(--lv, #2D6A4F)" />
  <circle cx="20.5" cy="38.5" r="2.6" fill="#f7d873" opacity=".85" />
  <circle cx="31.5" cy="38.5" r="2.6" fill="#f7d873" opacity=".85" />
  <path d="M20 32.5q2-2.4 4 0M28 32.5q2-2.4 4 0" stroke="var(--lc, #fffdf7)" stroke-width="2" fill="none" stroke-linecap="round" />
  <path d="M22.5 38.5q3.5 3.6 7 0" stroke="var(--lc, #fffdf7)" stroke-width="2" fill="none" stroke-linecap="round" />
  <path d="M20 24q-5-9-12-8" stroke="var(--lv, #2D6A4F)" stroke-width="2" fill="none" stroke-linecap="round" />
  <circle cx="7.5" cy="16" r="2.6" fill="#F4C430" />
</svg>
