---
/** Couverture d'Ange (illustration du 25/11), titre posé par le site. */
import { u } from '../lib/url';
---
<svg viewBox="0 0 400 500" role="img" aria-label="Couverture : Ange, le loup qui chantait avec le vent" class="couverture">
  <defs>
    <linearGradient id="couv-ombre" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0.6" stop-color="#14301f" stop-opacity="0" />
      <stop offset="1" stop-color="#14301f" stop-opacity="0.85" />
    </linearGradient>
  </defs>
  <image href={u('/img/ange-couverture.webp')} width="400" height="500" preserveAspectRatio="xMidYMid slice" />
  <rect width="400" height="500" fill="url(#couv-ombre)" />
  <text x="40" y="452" font-family="Fraunces Variable, Georgia, serif" font-size="44" font-weight="700" fill="#fffdf7">Ange</text>
  <text x="40" y="478" font-family="Nunito Sans, sans-serif" font-size="14" font-weight="800" letter-spacing="2" fill="#f7d873">LE LOUP QUI CHANTAIT AVEC LE VENT</text>
</svg>
