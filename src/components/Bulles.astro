---
/**
 * Fond animé : les petits logos Clémi (livre-sapin, livre, casque, bulle…) remontent
 * comme des bulles, en vert sapin transparent. À placer en premier enfant d'une section.
 * Le calque reste à l'écran pendant toute la traversée de la section (sticky).
 * Rien n'est affiché si l'utilisateur a demandé de réduire les animations.
 */
interface Props { nombre?: number; ton?: 'sapin' | 'creme'; graine?: number }
const { nombre = 16, ton = 'sapin', graine = 7 } = Astro.props;
const [opMin, opPlage] = ton === 'sapin' ? [0.08, 0.14] : [0.06, 0.1];

// Tirage pseudo-aléatoire fixe : même disposition à chaque génération
let seed = graine;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const formes = ['livre-sapin', 'livre', 'casque', 'bulle', 'etoile', 'sapin'];
const bulles = Array.from({ length: nombre }, (_, i) => {
  const duree = 18 + rand() * 18;
  return {
    forme: formes[i % formes.length],
    left: ((i + rand() * 0.8) / nombre) * 100,
    taille: 26 + rand() * 70,
    duree,
    delai: -rand() * duree,
    balance: 10 + rand() * 30,
    dureeBalance: 4 + rand() * 4,
    opacite: opMin + rand() * opPlage,
    rotation: (rand() < 0.5 ? -1 : 1) * (30 + rand() * 90),
  };
});
---
<div class="bulles-zone" aria-hidden="true">
<div class:list={['bulles', `bulles-${ton}`]} data-bulles>
  {bulles.map((b) => (
    <span
      class="bulle"
      style={`left:${b.left.toFixed(1)}%;width:${b.taille.toFixed(0)}px;--o:${b.opacite.toFixed(3)};--rot:${b.rotation.toFixed(0)}deg;animation-duration:${b.duree.toFixed(1)}s;animation-delay:${b.delai.toFixed(1)}s`}
    >
      <span class="bulle-balance" style={`--b:${b.balance.toFixed(0)}px;animation-duration:${b.dureeBalance.toFixed(1)}s`}>
        {b.forme === 'livre-sapin' && (
          <svg viewBox="0 0 64 64"><path d="M32 6l2.2 4.6 5 .6-3.7 3.4 1 5-4.5-2.5-4.5 2.5 1-5-3.7-3.4 5-.6z"/><path d="M32 18l-11 12h6l-9 10h28l-9-10h6z"/><path d="M6 46c9-4 18-4 26 1 8-5 17-5 26-1v10c-9-4-18-4-26 1-8-5-17-5-26-1z"/></svg>
        )}
        {b.forme === 'livre' && (
          <svg viewBox="0 0 24 24"><path d="M2 5.2C5.4 3.6 8.7 3.7 12 5.8c3.3-2.1 6.6-2.2 10-.6V20c-3.4-1.5-6.7-1.4-10 .8-3.3-2.2-6.6-2.3-10-.8z"/></svg>
        )}
        {b.forme === 'casque' && (
          <svg viewBox="0 0 24 24"><path d="M3 15v-3a9 9 0 0 1 18 0v3h-2.2v-3a6.8 6.8 0 0 0-13.6 0v3zM3 14h4.5v7H4.2A1.2 1.2 0 0 1 3 19.8zM21 14h-4.5v7h3.3a1.2 1.2 0 0 0 1.2-1.2z"/></svg>
        )}
        {b.forme === 'bulle' && (
          <svg viewBox="0 0 24 24"><path d="M3 4h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-9l-6 4.5V17H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/></svg>
        )}
        {b.forme === 'etoile' && (
          <svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2l-6.1 3.4 1.4-6.8-5.1-4.7 6.9-.8z"/></svg>
        )}
        {b.forme === 'sapin' && (
          <svg viewBox="0 0 24 24"><path d="M12 1l-6 8h3.5L4 16h6v6h4v-6h6l-5.5-7H18z"/></svg>
        )}
      </span>
    </span>
  ))}
</div>
</div>

<style>
  .bulles-zone { position: absolute; inset: 0; z-index: 0; overflow: clip; pointer-events: none; }
  .bulles {
    position: sticky; top: 0;
    height: 100vh; height: 100svh;
    overflow: hidden;
  }
  .bulle {
    position: absolute; bottom: 0;
    color: var(--sapin); opacity: 0;
    animation: monter linear infinite;
    animation-play-state: paused;
    will-change: transform, opacity;
  }
  .bulles-creme .bulle { color: var(--creme); }
  .bulle-balance { display: block; animation: balancer ease-in-out infinite alternate; animation-play-state: paused; }
  .bulle svg { display: block; width: 100%; height: auto; fill: currentColor; }
  .bulles.actif .bulle, .bulles.actif .bulle-balance { animation-play-state: running; }
  @keyframes monter {
    0% { transform: translateY(110%) rotate(0deg); opacity: 0; }
    12% { opacity: var(--o); }
    80% { opacity: var(--o); }
    100% { transform: translateY(calc(-100vh - 100%)) rotate(var(--rot)); opacity: 0; }
  }
  @keyframes balancer {
    from { transform: translateX(calc(var(--b) * -1)); }
    to { transform: translateX(var(--b)); }
  }
  @media (prefers-reduced-motion: reduce) { .bulles { display: none; } }
</style>

<script>
  // Les bulles ne bougent que lorsque leur section est à l'écran
  document.querySelectorAll<HTMLElement>('[data-bulles]').forEach((el) => {
    const section = el.parentElement?.parentElement;
    if (!section || !('IntersectionObserver' in window)) return el.classList.add('actif');
    new IntersectionObserver(([e]) => el.classList.toggle('actif', e.isIntersecting)).observe(section);
  });
</script>
