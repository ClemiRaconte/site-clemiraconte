<style>
  .crete { display: block; width: 100%; height: clamp(44px, 7vw, 100px); fill: var(--c); position: absolute; left: 0; z-index: 2; pointer-events: none; }
  .crete-haut { top: 2px; transform: translateY(-100%); }
  .crete-bas { bottom: 2px; transform: translateY(100%) scaleY(-1); }
  .crete-neige { fill: #fff; display: none; }
  :global(html[data-saison='hiver']) .crete-neige { display: block; }
  .crete-ligne { fill: none; stroke: var(--soleil, #F4C430); stroke-width: 4; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
</style>
