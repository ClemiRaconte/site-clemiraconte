---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
interface Props { titre: string; surtitre: string; intro: string; description: string }
const { titre, surtitre, intro, description } = Astro.props;
---
<Base titre={`${titre} · Clémi Raconte`} description={description}>
  <section class="section">
    <div class="conteneur chantier">
      <p class="surtitre">{surtitre}</p>
      <h1>{titre}</h1>
      <p class="intro">{intro}</p>
      <p class="note">Cette page est en cours de refonte. Elle reprendra les contenus du site actuel dans la nouvelle mise en page.</p>
      <div class="actions">
        <a class="btn btn-plein" href={u('/abonnement')}>Choisir ma formule</a>
        <a class="btn btn-contour" href={u('/')}>Retour à l’accueil</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .chantier { display: grid; gap: 18px; max-width: 760px; }
  .intro { font-size: 1.2rem; color: var(--gris); }
  .note { background: var(--creme-carte); border: 1px dashed var(--soleil); border-radius: var(--r-s); padding: 14px 18px; font-size: 0.95rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
